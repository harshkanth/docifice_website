---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Case Studies" description="See how Docifice has helped companies across industries improve their documentation, reduce support load, and ship better content.">

<style>
.cs-hero{background:#fff;padding:80px 0 72px;border-bottom:1px solid #f0f0f0;position:relative;overflow:hidden;}
.cs-hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;}
.cs-hero-inner{max-width:1400px;margin:0 auto;padding:0 32px;position:relative;z-index:2;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;}


.cs-eyebrow{font-size:11px;font-weight:700;letter-spacing:.04em;color:#0078D4;margin-bottom:16px;}
.cs-hero h1{font-size:56px;font-weight:800;color:#0a0a0a;letter-spacing:-.04em;line-height:1.04;margin-bottom:20px;}
.cs-hero h1 em{font-style:normal;color:#0078D4;}
.cs-hero p{font-size:17px;color:#666;line-height:1.7;}

.filter-bar{background:#fff;border-bottom:1px solid #f0f0f0;position:sticky;top:0;z-index:10;}
.filter-inner{max-width:1400px;margin:0 auto;padding:14px 32px;display:flex;align-items:center;gap:8px;overflow-x:auto;scrollbar-width:none;justify-content:space-between;}
.filter-inner::-webkit-scrollbar{display:none;}
.filter-btn{all:unset;font-family:"Plus Jakarta Sans",sans-serif;font-size:13px;font-weight:600;padding:7px 16px;border-radius:20px;cursor:pointer;white-space:nowrap;border:1.5px solid #eaecf0;color:#555;background:#fff;transition:all .2s;flex:1;text-align:center;}
.filter-btn:hover{border-color:#0078D4;color:#0078D4;}
.filter-btn.active{background:#0078D4;color:#fff;border-color:#0078D4;}
.cs-body{background:#f8f9fa;padding:64px 0;}
.cs-inner{max-width:1400px;margin:0 auto;padding:0 32px;}
.cs-featured{background:#fff;border-radius:16px;border:1px solid #eaecf0;overflow:hidden;margin-bottom:24px;display:grid;grid-template-columns:1fr 1fr;}
.cs-featured-content{padding:48px;}
.cs-featured-visual{background:#021430;display:flex;align-items:center;justify-content:center;padding:48px;position:relative;overflow:hidden;}
.cs-featured-visual::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 80% 80% at 50% 50%,rgba(0,120,212,.3) 0%,transparent 70%);}
.cs-tag{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;letter-spacing:.04em;color:#0078D4;background:#f0f5ff;padding:4px 10px;border-radius:20px;margin-bottom:16px;}
.cs-featured-content h2{font-size:28px;font-weight:800;color:#0a0a0a;letter-spacing:-.03em;line-height:1.2;margin-bottom:12px;}
.cs-featured-content p{font-size:15px;color:#666;line-height:1.7;margin-bottom:24px;}
.cs-result{background:#f0f5ff;border-radius:10px;padding:16px 20px;margin-bottom:24px;}
.cs-result-label{font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#0078D4;margin-bottom:4px;}
.cs-result-value{font-size:15px;font-weight:700;color:#0a0a0a;}
.cs-meta{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:28px;}
.cs-meta-item{font-size:12px;color:#888;display:flex;align-items:center;gap:5px;}
.cs-read-more{all:unset;display:inline-flex;align-items:center;gap:8px;font-family:"Plus Jakarta Sans",sans-serif;font-size:14px;font-weight:700;color:#0078D4;cursor:pointer;transition:gap .2s;}
.cs-read-more:hover{gap:12px;}
.cs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
.cs-card{background:#fff;border-radius:14px;border:1px solid #eaecf0;overflow:hidden;transition:transform .22s cubic-bezier(.34,1.1,.64,1),box-shadow .22s;display:flex;flex-direction:column;}
.cs-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(0,0,0,.08);}
.cs-card-banner{height:140px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.cs-card-content{padding:24px;flex:1;display:flex;flex-direction:column;}
.cs-card-tag{font-size:10px;font-weight:700;letter-spacing:.04em;color:#0078D4;margin-bottom:10px;}
.cs-card h3{font-size:17px;font-weight:800;color:#0a0a0a;letter-spacing:-.02em;line-height:1.3;margin-bottom:8px;}
.cs-card p{font-size:13px;color:#666;line-height:1.65;margin-bottom:16px;flex:1;}
.cs-card-result{background:#f8f9fa;border-radius:8px;padding:12px 14px;margin-bottom:16px;}
.cs-card-result-label{font-size:9px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#0078D4;margin-bottom:3px;}
.cs-card-result-value{font-size:13px;font-weight:700;color:#0a0a0a;}
.cs-card-meta{display:flex;gap:12px;align-items:center;}
.cs-card-meta span{font-size:11px;color:#aaa;}
.cs-card-link{font-size:13px;font-weight:700;color:#0078D4;margin-left:auto;display:flex;align-items:center;gap:4px;}
.wrap{max-width:1400px;margin:0 auto;padding:0 32px;}
</style>

<!-- HERO -->
<div class="cs-hero">
  <div class="cs-hero-inner">
    <div>
      <div class="cs-eyebrow">Case Studies</div>
      <h1>Real work. <em>Real results.</em></h1>
      <p>See how we have helped companies across industries reduce support load, improve developer experience, and ship documentation that actually works.</p>
    </div>
    <div style="border-radius:16px;overflow:hidden;box-shadow:0 32px 80px rgba(0,0,0,.4);position:relative;">
      <img src="data:image/jpeg;base64," alt="Case Studies" style="width:100%;height:340px;object-fit:cover;display:block;"/>
    </div>
  </div>
</div>

</div>
</div>



<!-- FILTER BAR -->
<div class="filter-bar">
  <div class="filter-inner">
    <button class="filter-btn active" data-filter="all">All</button>
    <button class="filter-btn" data-filter="technical-documentation">Technical Documentation</button>
    <button class="filter-btn" data-filter="api-documentation">API &amp; Developer Docs</button>
    <button class="filter-btn" data-filter="knowledge-management">Knowledge Management</button>
    <button class="filter-btn" data-filter="content-strategy">Content Strategy</button>
    <button class="filter-btn" data-filter="training">Training &amp; Enablement</button>
    <button class="filter-btn" data-filter="documentation-engineering">Documentation Engineering</button>
  </div>
</div>

<!-- CASE STUDIES -->
<div class="cs-body">
  <div class="cs-inner">

    <div class="cs-featured" data-category="technical-documentation">
      <div class="cs-featured-content">
        <div class="cs-tag"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg> Featured</div>
        <h2>Rebuilding a 400-page enterprise user guide from the ground up</h2>
        <p>An enterprise IAM software company had a user guide that had not been updated in three years. Outdated procedures, missing sections, no consistent style, and a support team drowning in tickets that the docs should have answered.</p>
        <div class="cs-result"><div class="cs-result-label">Key outcome</div><div class="cs-result-value">42% reduction in support tickets within 90 days of launch</div></div>
        <div class="cs-meta">
          <span class="cs-meta-item"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg> Enterprise SaaS</span>
          <span class="cs-meta-item"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16h16V8z"/></svg> Technical Documentation</span>
          <span class="cs-meta-item"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> 8 weeks</span>
        </div>
        <a href="#" class="cs-read-more">Read case study <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
      </div>
      <div class="cs-featured-visual">
        <div style="position:relative;z-index:2;text-align:center;">
          <div style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:32px 40px;">
            <div style="font-size:48px;font-weight:800;color:#fff;letter-spacing:-.04em;margin-bottom:8px;">42<span style="color:#0078D4;">%</span></div>
            <div style="font-size:14px;color:rgba(255,255,255,.6);margin-bottom:24px;">Fewer support tickets</div>
            <div style="display:flex;flex-direction:column;gap:10px;">
              <div style="display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.05);border-radius:8px;padding:10px 14px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span style="font-size:12px;color:rgba(255,255,255,.7);">400+ pages restructured</span></div>
              <div style="display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.05);border-radius:8px;padding:10px 14px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span style="font-size:12px;color:rgba(255,255,255,.7);">Style guide created</span></div>
              <div style="display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.05);border-radius:8px;padding:10px 14px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span style="font-size:12px;color:rgba(255,255,255,.7);">Delivered in 8 weeks</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="cs-grid">
      <div class="cs-card" data-category="api-documentation">
        <div class="cs-card-banner" style="background:#021430;"><div style="text-align:center;position:relative;z-index:2;"><div style="font-size:32px;font-weight:800;color:#fff;letter-spacing:-.03em;">60<span style="color:#0078D4;">%</span></div><div style="font-size:12px;color:rgba(255,255,255,.5);margin-top:4px;">Faster developer onboarding</div></div><div style="position:absolute;inset:0;background:radial-gradient(ellipse 80% 80% at 50% 50%,rgba(0,120,212,.25) 0%,transparent 70%);"></div></div>
        <div class="cs-card-content">
          <div class="cs-card-tag">API &amp; Developer Documentation</div>
          <h3>API documentation overhaul for a payments platform</h3>
          <p>The existing API docs were incomplete and inconsistent. Developers were abandoning integrations midway and raising support tickets for basic questions.</p>
          <div class="cs-card-result"><div class="cs-card-result-label">Key outcome</div><div class="cs-card-result-value">60% faster developer onboarding</div></div>
          <div class="cs-card-meta"><span>FinTech</span><span>12 weeks</span><a href="#" class="cs-card-link">Read more <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a></div>
        </div>
      </div>

      <div class="cs-card" data-category="knowledge-management">
        <div class="cs-card-banner" style="background:#0f172a;"><div style="text-align:center;position:relative;z-index:2;"><div style="font-size:32px;font-weight:800;color:#fff;letter-spacing:-.03em;">3x</div><div style="font-size:12px;color:rgba(255,255,255,.5);margin-top:4px;">Knowledge base search success</div></div><div style="position:absolute;inset:0;background:radial-gradient(ellipse 80% 80% at 50% 50%,rgba(0,120,212,.2) 0%,transparent 70%);"></div></div>
        <div class="cs-card-content">
          <div class="cs-card-tag">Knowledge Management</div>
          <h3>Knowledge base rebuild for a global HR platform</h3>
          <p>A disorganized knowledge base with no taxonomy, duplicate content, and outdated articles was pushing users to contact support instead of self-serving.</p>
          <div class="cs-card-result"><div class="cs-card-result-label">Key outcome</div><div class="cs-card-result-value">3x improvement in search success rate</div></div>
          <div class="cs-card-meta"><span>HR Technology</span><span>6 weeks</span><a href="#" class="cs-card-link">Read more <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a></div>
        </div>
      </div>

      <div class="cs-card" data-category="documentation-engineering">
        <div class="cs-card-banner" style="background:#1e1e1e;"><div style="text-align:center;position:relative;z-index:2;"><div style="font-size:32px;font-weight:800;color:#fff;letter-spacing:-.03em;">0</div><div style="font-size:12px;color:rgba(255,255,255,.5);margin-top:4px;">Manual publishing steps remaining</div></div></div>
        <div class="cs-card-content">
          <div class="cs-card-tag">Documentation Engineering</div>
          <h3>Docs-as-code migration for a developer tools company</h3>
          <p>A team publishing docs manually via a CMS with no version control, no review process, and no way to keep docs in sync with product releases.</p>
          <div class="cs-card-result"><div class="cs-card-result-label">Key outcome</div><div class="cs-card-result-value">Fully automated CI/CD doc pipeline</div></div>
          <div class="cs-card-meta"><span>Developer Tools</span><span>4 weeks</span><a href="#" class="cs-card-link">Read more <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a></div>
        </div>
      </div>

      <div class="cs-card" data-category="content-strategy">
        <div class="cs-card-banner" style="background:#021430;"><div style="text-align:center;position:relative;z-index:2;"><div style="font-size:32px;font-weight:800;color:#fff;letter-spacing:-.03em;">85<span style="color:#0078D4;">%</span></div><div style="font-size:12px;color:rgba(255,255,255,.5);margin-top:4px;">Reduction in style inconsistencies</div></div><div style="position:absolute;inset:0;background:radial-gradient(ellipse 80% 80% at 50% 50%,rgba(0,120,212,.2) 0%,transparent 70%);"></div></div>
        <div class="cs-card-content">
          <div class="cs-card-tag">Content Strategy &amp; Design</div>
          <h3>Content strategy and style guide for a SaaS platform</h3>
          <p>Multiple teams writing documentation independently with no shared standards, resulting in inconsistent voice, terminology, and formatting across all content.</p>
          <div class="cs-card-result"><div class="cs-card-result-label">Key outcome</div><div class="cs-card-result-value">85% reduction in style inconsistencies</div></div>
          <div class="cs-card-meta"><span>Enterprise SaaS</span><span>5 weeks</span><a href="#" class="cs-card-link">Read more <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a></div>
        </div>
      </div>

      <div class="cs-card" data-category="training">
        <div class="cs-card-banner" style="background:#0f172a;"><div style="text-align:center;position:relative;z-index:2;"><div style="font-size:32px;font-weight:800;color:#fff;letter-spacing:-.03em;">50<span style="color:#0078D4;">%</span></div><div style="font-size:12px;color:rgba(255,255,255,.5);margin-top:4px;">Faster new hire ramp-up</div></div><div style="position:absolute;inset:0;background:radial-gradient(ellipse 80% 80% at 50% 50%,rgba(0,120,212,.2) 0%,transparent 70%);"></div></div>
        <div class="cs-card-content">
          <div class="cs-card-tag">Training &amp; Enablement</div>
          <h3>Employee onboarding programme for a global technology firm</h3>
          <p>New hires were taking 90 days to reach full productivity. Onboarding documentation was scattered, outdated, and not role-specific.</p>
          <div class="cs-card-result"><div class="cs-card-result-label">Key outcome</div><div class="cs-card-result-value">50% faster ramp-up time for new hires</div></div>
          <div class="cs-card-meta"><span>Technology</span><span>6 weeks</span><a href="#" class="cs-card-link">Read more <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a></div>
        </div>
      </div>

      <div class="cs-card" data-category="technical-documentation">
        <div class="cs-card-banner" style="background:#021430;"><div style="text-align:center;position:relative;z-index:2;"><div style="font-size:32px;font-weight:800;color:#fff;letter-spacing:-.03em;">30<span style="color:#0078D4;">%</span></div><div style="font-size:12px;color:rgba(255,255,255,.5);margin-top:4px;">Reduction in implementation time</div></div><div style="position:absolute;inset:0;background:radial-gradient(ellipse 80% 80% at 50% 50%,rgba(0,120,212,.2) 0%,transparent 70%);"></div></div>
        <div class="cs-card-content">
          <div class="cs-card-tag">Technical Documentation</div>
          <h3>Installation and configuration guide for an enterprise security platform</h3>
          <p>Customers were spending weeks on implementations that should have taken days. The installation guide was incomplete and assumed too much prior knowledge.</p>
          <div class="cs-card-result"><div class="cs-card-result-label">Key outcome</div><div class="cs-card-result-value">30% reduction in average implementation time</div></div>
          <div class="cs-card-meta"><span>Cybersecurity</span><span>4 weeks</span><a href="#" class="cs-card-link">Read more <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- CTA + WAVES -->
<div class="bottom">
  <div class="wrap">
    <div class="cta">
      <div class="cta-eyebrow">Ready when you are</div>
      <h2 class="cta-h2">Let's add your project to this <em>list.</em></h2>
      <p class="cta-sub">Tell us what you are working on. We will scope it, plan it, and deliver documentation that moves the needle.</p>
      <div class="cta-btns">
        <button class="btn-lift" style="all:unset;box-sizing:border-box;transition:transform .22s cubic-bezier(.34,1.1,.64,1),box-shadow .22s;display:inline-flex;align-items:center;gap:8px;background-color:#0a0a0a;color:#fff;padding:13px 28px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;" onclick="location.href='/contact'">Get in touch <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button>
        <button class="btn-lift" style="all:unset;box-sizing:border-box;transition:transform .22s cubic-bezier(.34,1.1,.64,1),box-shadow .22s;display:inline-flex;align-items:center;gap:8px;background-color:#fff;color:#0a0a0a;border:1.5px solid #d0d0d0;padding:12px 24px;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;" onclick="location.href='/work/success-stories'">View success stories <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0a0a0a" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button>
      </div>
    </div>
  </div>
  <canvas id="waveCanvas"></canvas>
</div>

<script>
document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const filter = btn.dataset.filter;
    document.querySelectorAll('.cs-card, .cs-featured').forEach(card => {
      card.style.display = (filter === 'all' || card.dataset.category === filter) ? '' : 'none';
    });
  });
});
const wc=document.getElementById('waveCanvas');
const wx=wc&&wc.getContext('2d');
function resize(){if(!wc)return;wc.width=wc.offsetWidth;wc.height=200;}
resize();window.addEventListener('resize',resize);
const layers=[
  {a:20,s:.0009,c1:'#b8d0e8',c2:'#88b0d0',y:0.44,o:.5,p:0},
  {a:18,s:.0007,c1:'#4888c0',c2:'#0078D4',y:0.54,o:.62,p:1.8},
  {a:18,s:.0011,c1:'#0060a8',c2:'#004880',y:0.65,o:.72,p:3.2},
  {a:16,s:.0006,c1:'#003060',c2:'#002040',y:0.75,o:.82,p:0.9},
  {a:14,s:.0013,c1:'#011828',c2:'#021430',y:0.85,o:.93,p:2.1},
  {a:10,s:.0005,c1:'#010e20',c2:'#010e20',y:0.93,o:1,p:1.2},
];
function draw(t){
  if(!wx||!wc)return;
  const W=wc.width,H=wc.height;
  wx.clearRect(0,0,W,H);
  wx.fillStyle='#f8f9fa';wx.fillRect(0,0,W,H);
  layers.forEach(l=>{
    wx.beginPath();
    const by=H*l.y;wx.moveTo(0,H);
    for(let x=0;x<=W;x+=2){
      const n=x/W;
      const raw=by+Math.sin(n*Math.PI*3.5+t*l.s+l.p)*l.a+Math.sin(n*Math.PI*6+t*l.s*.65+l.p*1.4)*l.a*.35;
      wx.lineTo(x,Math.max(by-l.a*1.45,raw));
    }
    wx.lineTo(W,H);wx.closePath();
    const g=wx.createLinearGradient(0,0,W,0);
    g.addColorStop(0,l.c1);g.addColorStop(1,l.c2);
    wx.fillStyle=g;wx.globalAlpha=l.o;wx.fill();
  });
  wx.globalAlpha=1;requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>

</BaseLayout>