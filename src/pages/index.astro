 <div class="line-bg"></div>
 <div class="line-progress" id="lp"></div>
 <div class="sn" id="sn0" style="left:0%"></div>
 <div class="sn" id="sn1" style="left:33%"></div>
 <div class="sn" id="sn2" style="left:67%"></div>
 <div class="sn" id="sn3" style="left:100%"></div>
