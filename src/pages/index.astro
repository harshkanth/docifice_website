 <div class="imp-outcome"><div class="imp-outcome-icon"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div><div class="imp-outcome-body"><div class="imp-outcome-label">User retention</div><div class="imp-outcome-val" style="color:#7c3aed"><span>&#8593;</span> <span id="mv1"></span></div><div class="imp-outcome-sub">Onboarding friction removed</div><div class="imp-mbar" style="margin-top:6px;"><div class="imp-mfill" id="mb1" style="background:#7c3aed"></div></div></div></div>
 <div class="imp-outcome"><div class="imp-outcome-icon"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg></div><div class="imp-outcome-body"><div class="imp-outcome-label">Revenue impact</div><div class="imp-outcome-val" style="color:#16a34a"><span>&#8593;</span> <span id="mv2"></span></div><div class="imp-outcome-sub">Faster time to value for customers</div><div class="imp-mbar" style="margin-top:6px;"><div class="imp-mfill" id="mb2" style="background:#16a34a"></div></div></div></div>
 </div>
 <div class="imp-footer" style="margin-top:0;"><span><span class="imp-fdot"></span><span class="aft">Next engagement begins in <span id="cd">8</span>s</span></span><span class="aft" style="color:#ccc;">delivered on time &#10003;</span></div>
 </div>
 </div>
 </div><!-- end anim-screen -->
 </div><!-- end hero-anim -->

 </div><!-- end hero-top -->

 <div class="stats">
 <div class="st"><div class="st-num">11<span style="color:#7dd3fc;">+</span></div><div class="st-lbl">Years of expertise</div></div>
 <div class="st"><div class="st-num">500<span style="color:#7dd3fc;">+</span></div><div class="st-lbl">Projects delivered</div></div>
 <div class="st"><div class="st-num" style="color:#7dd3fc;">100%</div><div class="st-lbl">On-time delivery</div></div>
 <div class="st"><div class="st-num" style="color:#7dd3fc;font-size:15px;letter-spacing:-.01em;">AI&#8209;Ready</div><div class="st-lbl">Documentation</div></div>
 </div>

 </div><!-- end hero-inner -->
