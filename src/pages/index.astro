 <div class="mq-item"><span>Enterprise Software</span></div><div class="mq-item"><span>Fintech</span></div><div class="mq-item"><span>Payments</span></div><div class="mq-item"><span>Data Security</span></div><div class="mq-item"><span>Healthcare</span></div><div class="mq-item"><span>MedTech</span></div><div class="mq-item"><span>E-commerce</span></div><div class="mq-item"><span>FMCG</span></div><div class="mq-item"><span>Automotive</span></div><div class="mq-item"><span>Cloud Infrastructure</span></div><div class="mq-item"><span>Identity Management</span></div><div class="mq-item"><span>SaaS Platforms</span></div><div class="mq-item"><span>Insurance</span></div><div class="mq-item"><span>Energy</span></div><div class="mq-item"><span>Developer Tools</span></div><div class="mq-item"><span>Supply Chain</span></div>
