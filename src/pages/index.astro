 <div class="di lit" id="di4"><div class="di-icon"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div><div class="di-name">AI Search Optimization</div><span class="di-tag">SEO &middot; GEO &middot; AEO</span><span class="di-stage" id="ds4">scoping</span><div class="di-tick" id="dt4"></div></div>
