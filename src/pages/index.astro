 <span class="sl" id="sl0" style="left:0%;transform:translateX(0);">Scope</span>
 <span class="sl" id="sl1" style="left:33%;">Research</span>
 <span class="sl" id="sl2" style="left:67%;">Write</span>
 <span class="sl" id="sl3" style="left:100%;transform:translateX(-100%);">Deliver</span>
 </div>
