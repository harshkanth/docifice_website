<BaseLayout title="Words that make your product work" description="Docifice — Technical documentation, content, SEO, AEO, and product training for teams that know clarity is a competitive advantage.">

<div class="hero">
  <div class="hero-bg"></div><div class="hero-dots"></div>
  <div class="wrap">
 <div class="hero-inner">

 <!-- TOP ROW: copy left, animation right -->
 <div class="hero-top">

 <!-- LEFT -->
 <div class="hero-content">
 <h1>Words that make<br>your product <em>work.</em></h1>
 <p class="sub">Documentation, content, SEO, AEO, and product training for teams that know clarity is a competitive advantage.</p>
 <div class="btns">
 <button class="btn-lift" style="all:unset;box-sizing:border-box;transition:transform .22s cubic-bezier(.34,1.1,.64,1),box-shadow .22s cubic-bezier(.34,1.1,.64,1);display:inline-flex;align-items:center;gap:8px;background-color:#ffffff;color:#021430;padding:12px 26px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;" onclick="location.href='/contact'">Get in touch <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#021430" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button>
 <button class="btn-lift" onclick="document.getElementById('services-section').scrollIntoView({behavior:'smooth'})" style="all:unset;box-sizing:border-box;display:inline-flex;align-items:center;gap:8px;background-color:#ffffff;color:#021430;padding:12px 22px;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;">Explore services <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#021430" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button>
 </div>
 </div>

 <!-- RIGHT: animation -->
 <div class="hero-anim">
 <div class="anim-screen">
 <div class="anim-chrome">
 <div class="anim-chrome-left">
 <span class="anim-chrome-title" id="animTitle">Documentation Process</span>
 </div>
 <div class="anim-tabs">
 <div class="atab on" id="atab-p">Pipeline</div>
 <div class="atab" id="atab-i">Impact</div>
 </div>
 <div class="anim-chrome-right" id="animRight">live</div>
 </div>
 <div class="anim-body">
