---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Documentation Engineering" description="Professional documentation engineering services — docs-as-code, CI/CD pipelines, documentation portals, static sites, automation and more. Docifice builds docs like software.">

<style>
.td-hero{background:#021430;padding:72px 0 64px;position:relative;overflow:hidden;}
.td-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 70% 20%,rgba(0,120,212,.28) 0%,transparent 60%);pointer-events:none;}
.td-hero-inner{max-width:1400px;margin:0 auto;padding:0 32px;position:relative;z-index:2;display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center;}
.td-eyebrow{font-size:11px;font-weight:700;letter-spacing:.04em;color:#7dd3fc;margin-bottom:14px;}
.td-hero h1{font-size:52px;font-weight:800;color:#fff;letter-spacing:-.04em;line-height:1.04;margin-bottom:18px;}
.td-hero h1 em{font-style:normal;color:#7dd3fc;}
.td-hero p{font-size:16px;color:rgba(255,255,255,.58);line-height:1.76;max-width:480px;margin-bottom:32px;}
.td-hero-btns{display:flex;gap:12px;align-items:center;}
.trust-bar{background:#f8f9fa;border-bottom:1px solid #f0f0f0;padding:20px 0;}
.trust-bar-inner{max-width:1400px;margin:0 auto;padding:0 32px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;}
.trust-label{font-size:13px;font-weight:700;color:#0a0a0a;white-space:nowrap;}
.trust-items{display:flex;flex:1;justify-content:space-between;flex-wrap:wrap;align-items:center;margin-left:32px;}
.trust-item{font-size:13px;font-weight:600;color:#555;display:flex;align-items:center;gap:6px;}
.section{padding:88px 0;}
.section-alt{background:#f8f9fa;}
.wrap{max-width:1400px;margin:0 auto;padding:0 32px;}
.section-ey{font-size:11px;font-weight:700;letter-spacing:.04em;color:#0078D4;margin-bottom:12px;}
.section-h2{font-size:36px;font-weight:800;letter-spacing:-.04em;color:#0a0a0a;line-height:1.1;margin-bottom:14px;}
.section-sub{font-size:15px;color:#666;line-height:1.6;}
.del-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:40px;}
.del-cat{border-radius:12px;padding:24px 26px;border:1.5px solid #d8e2f0;border-top:3px solid #d8e2f0;background:#fff;transition:border-color .2s,box-shadow .2s,transform .22s cubic-bezier(.34,1.1,.64,1);}
.del-cat:hover{border-color:#c8ddf5;border-top-color:#0078D4;box-shadow:0 6px 20px rgba(0,120,212,.08);transform:translateY(-3px);}
.del-cat-icon{font-size:10px;font-weight:700;letter-spacing:.05em;color:#0078D4;margin-bottom:6px;display:block;}
.del-cat-title{font-size:15px;font-weight:800;color:#0a0a0a;letter-spacing:-.02em;margin-bottom:12px;}
.del-cat-list{list-style:none;display:flex;flex-direction:column;gap:6px;}
.del-cat-list li{font-size:12px;color:#444;padding-left:14px;position:relative;line-height:1.5;}
.del-cat-list li::before{content:'';position:absolute;left:0;top:6px;width:5px;height:5px;border-radius:50%;background:#0078D4;}
.aud-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:40px;}
.aud-card{background:#fff;border:1px solid #eaecf0;border-radius:10px;padding:18px 20px;display:flex;align-items:center;gap:12px;transition:border-color .2s,box-shadow .2s,transform .22s cubic-bezier(.34,1.1,.64,1);}
.aud-card:hover{border-color:#0078D4;box-shadow:0 4px 16px rgba(0,120,212,.08);transform:translateY(-2px);}
.aud-icon{width:32px;height:32px;border-radius:8px;background:#f0f5ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.aud-name{font-size:13px;font-weight:600;color:#0a0a0a;}
.process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:40px;}
.process-step{background:#fff;border:1px solid #e4edf8;border-radius:12px;padding:28px 24px;}
.process-num{font-size:11px;font-weight:700;color:#0078D4;letter-spacing:.04em;margin-bottom:12px;}
.process-title{font-size:16px;font-weight:800;color:#0a0a0a;margin-bottom:8px;letter-spacing:-.02em;}
.process-desc{font-size:13px;color:#666;line-height:1.65;}
.tools-grid{display:flex;flex-wrap:wrap;gap:10px;margin-top:32px;}
.tool-tag{font-size:12px;font-weight:600;padding:7px 14px;border-radius:8px;background:rgba(255,255,255,.07);color:rgba(255,255,255,.8);border:1px solid rgba(255,255,255,.1);transition:background .2s,color .2s,border-color .2s;}
.tool-tag:hover{background:rgba(0,120,212,.2);border-color:rgba(0,120,212,.4);color:#fff;}
.faq-list{display:flex;flex-direction:column;gap:2px;margin-top:48px;}
.faq-item{border:1px solid #eaecf0;border-radius:10px;overflow:hidden;}
.faq-q{padding:20px 24px;font-size:15px;font-weight:600;color:#0a0a0a;cursor:pointer;display:flex;justify-content:space-between;align-items:center;user-select:none;}
.faq-q:hover{background:#f8f9fa;}
.faq-a{padding:0 24px 0;font-size:14px;color:#555;line-height:1.74;max-height:0;overflow:hidden;transition:max-height .35s ease,padding .35s ease;}
.faq-item.open .faq-a{max-height:200px;padding:0 24px 20px;}
.faq-item.open .faq-chevron{transform:rotate(180deg);}
.faq-chevron{transition:transform .2s;flex-shrink:0;color:#0078D4;}
.btn-primary{all:unset;box-sizing:border-box;display:inline-flex;align-items:center;gap:8px;background:#0078D4;color:#fff;padding:13px 28px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;transition:transform .22s cubic-bezier(.34,1.1,.64,1),box-shadow .22s,opacity .2s;text-decoration:none;}
.btn-primary:hover{opacity:.88;transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,120,212,.3);}
.btn-ghost{all:unset;box-sizing:border-box;display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);color:#fff;border:1.5px solid rgba(255,255,255,.3);padding:12px 24px;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;transition:background .2s,transform .22s cubic-bezier(.34,1.1,.64,1);text-decoration:none;}
.btn-ghost:hover{background:rgba(255,255,255,.2);transform:translateY(-2px);}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
</style>

<!-- HERO -->
<div class="td-hero">
  <div class="td-hero-inner">
    <div>
      <div class="td-eyebrow">Documentation Engineering</div>
      <h1>Documentation that ships with your <em>product.</em></h1>
      <p>We set up the tooling, workflows, and pipelines that let your team write, review, and ship documentation the same way they ship code — with version control, automation, and zero manual publishing.</p>
      <div class="td-hero-btns">
        <a href="/contact" class="btn-primary" onclick="location.href='/contact'">Get in touch <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/work/case-studies" class="btn-ghost" onclick="location.href='/work/case-studies'">View case studies <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
      </div>
    </div>

    <!-- Hero visual: VSCode-style doc editor -->
    <div style="background:#1e1e1e;border-radius:16px;overflow:hidden;box-shadow:0 32px 80px rgba(0,0,0,.6);border:1px solid rgba(255,255,255,.08);">
      <!-- Title bar -->
      <div style="background:#323233;padding:8px 16px;display:flex;align-items:center;gap:8px;border-bottom:1px solid rgba(255,255,255,.06);">
        <div style="display:flex;gap:5px;">
          <div style="width:11px;height:11px;border-radius:50%;background:#ff5f57;"></div>
          <div style="width:11px;height:11px;border-radius:50%;background:#febc2e;"></div>
          <div style="width:11px;height:11px;border-radius:50%;background:#28c840;"></div>
        </div>
        <span style="font-size:11px;color:rgba(255,255,255,.4);font-family:'JetBrains Mono',monospace;margin-left:8px;">api-reference.md &middot; docs-repo</span>
      </div>
      <div style="display:grid;grid-template-columns:140px 1fr;">
        <!-- Sidebar: file explorer -->
        <div style="background:#252526;border-right:1px solid rgba(255,255,255,.06);padding:10px 0;">
          <div style="font-size:8px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.3);padding:0 12px;margin-bottom:8px;">Explorer</div>
          <div style="display:flex;flex-direction:column;">
            <div style="font-size:10px;color:rgba(255,255,255,.5);padding:3px 12px;display:flex;align-items:center;gap:5px;">
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.4)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>docs-repo
            </div>
            <div style="font-size:10px;color:rgba(255,255,255,.4);padding:3px 12px 3px 24px;">docs/</div>
            <div style="font-size:10px;color:rgba(255,255,255,.4);padding:3px 12px 3px 32px;">getting-started.md</div>
            <div style="font-size:10px;color:#60b0f4;padding:3px 12px 3px 32px;background:rgba(0,120,212,.15);">api-reference.md</div>
            <div style="font-size:10px;color:rgba(255,255,255,.4);padding:3px 12px 3px 32px;">authentication.md</div>
            <div style="font-size:10px;color:rgba(255,255,255,.4);padding:3px 12px 3px 32px;">errors.md</div>
            <div style="font-size:10px;color:rgba(255,255,255,.4);padding:3px 12px 3px 24px;">guides/</div>
            <div style="font-size:10px;color:rgba(255,255,255,.4);padding:3px 12px 3px 24px;">changelog.md</div>
            <div style="font-size:10px;color:rgba(255,255,255,.4);padding:3px 12px 3px 12px;">.github/</div>
            <div style="font-size:10px;color:rgba(255,255,255,.4);padding:3px 12px 3px 12px;">docusaurus.config.js</div>
            <div style="font-size:10px;color:rgba(255,255,255,.4);padding:3px 12px 3px 12px;">.vale.ini</div>
          </div>
        </div>
        <!-- Editor -->
        <div style="background:#1e1e1e;padding:14px 16px;font-family:'JetBrains Mono',monospace;">
          <!-- Line numbers + content -->
          <div style="display:flex;flex-direction:column;gap:2px;">
            <div style="display:flex;gap:12px;">
              <span style="font-size:10px;color:rgba(255,255,255,.2);width:16px;text-align:right;">1</span>
              <span style="font-size:10px;color:#608b4e;"># Authentication</span>
            </div>
            <div style="display:flex;gap:12px;">
              <span style="font-size:10px;color:rgba(255,255,255,.2);width:16px;text-align:right;">2</span>
              <span style="font-size:10px;color:rgba(255,255,255,.15);">&nbsp;</span>
            </div>
            <div style="display:flex;gap:12px;">
              <span style="font-size:10px;color:rgba(255,255,255,.2);width:16px;text-align:right;">3</span>
              <span style="font-size:10px;color:#d4d4d4;">All API requests require a Bearer token.</span>
            </div>
            <div style="display:flex;gap:12px;">
              <span style="font-size:10px;color:rgba(255,255,255,.2);width:16px;text-align:right;">4</span>
              <span style="font-size:10px;color:rgba(255,255,255,.15);">&nbsp;</span>
            </div>
            <div style="display:flex;gap:12px;">
              <span style="font-size:10px;color:rgba(255,255,255,.2);width:16px;text-align:right;">5</span>
              <span style="font-size:10px;color:#608b4e;">## Obtaining a token</span>
            </div>
            <div style="display:flex;gap:12px;">
              <span style="font-size:10px;color:rgba(255,255,255,.2);width:16px;text-align:right;">6</span>
              <span style="font-size:10px;color:rgba(255,255,255,.15);">&nbsp;</span>
            </div>
            <div style="display:flex;gap:12px;">
              <span style="font-size:10px;color:rgba(255,255,255,.2);width:16px;text-align:right;">7</span>
              <span style="font-size:10px;color:#d4d4d4;">To authenticate, send a <span style="color:#ce9178;">`POST`</span> request to</span>
            </div>
            <div style="display:flex;gap:12px;">
              <span style="font-size:10px;color:rgba(255,255,255,.2);width:16px;text-align:right;">8</span>
              <span style="font-size:10px;color:#ce9178;">`/api/v2/auth/token`</span><span style="font-size:10px;color:#d4d4d4;"> with your credentials.</span>
            </div>
            <div style="display:flex;gap:12px;">
              <span style="font-size:10px;color:rgba(255,255,255,.2);width:16px;text-align:right;">9</span>
              <span style="font-size:10px;color:rgba(255,255,255,.15);">&nbsp;</span>
            </div>
            <div style="display:flex;gap:12px;">
              <span style="font-size:10px;color:rgba(255,255,255,.2);width:16px;text-align:right;">10</span>
              <span style="font-size:10px;color:#608b4e;">## Request headers</span>
            </div>
            <div style="display:flex;gap:12px;">
              <span style="font-size:10px;color:rgba(255,255,255,.2);width:16px;text-align:right;">11</span>
              <span style="font-size:10px;color:rgba(255,255,255,.15);">&nbsp;</span>
            </div>
            <div style="display:flex;gap:12px;">
              <span style="font-size:10px;color:rgba(255,255,255,.2);width:16px;text-align:right;">12</span>
              <span style="font-size:10px;color:#d4d4d4;">Include the token in the <span style="color:#ce9178;">`Authorization`</span> header<span style="display:inline-block;width:1px;height:10px;background:#60b0f4;margin-left:1px;vertical-align:middle;animation:blink 1s step-end infinite;"></span></span>
            </div>
          </div>
        </div>
      </div>
      <!-- Status bar -->
      <div style="background:#0078D4;padding:3px 16px;display:flex;align-items:center;justify-content:space-between;">
        <div style="display:flex;align-items:center;gap:12px;">
          <span style="font-size:9px;color:rgba(255,255,255,.9);font-family:'JetBrains Mono',monospace;">main</span>
          <span style="font-size:9px;color:rgba(255,255,255,.7);font-family:'JetBrains Mono',monospace;">0 errors &middot; 0 warnings</span>
        </div>
        <span style="font-size:9px;color:rgba(255,255,255,.7);font-family:'JetBrains Mono',monospace;">Markdown</span>
      </div>
    </div>
  </div>
</div>

<!-- TRUST BAR -->
<div class="trust-bar">
  <div class="trust-bar-inner">
    <span class="trust-label">Trusted By</span>
    <div class="trust-items">
      <span class="trust-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Engineering-led teams</span>
      <span class="trust-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Developer tool companies</span>
      <span class="trust-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Platform & API teams</span>
      <span class="trust-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Enterprise documentation teams</span>
      <span class="trust-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Global enterprise teams</span>
    </div>
  </div>
</div>

<!-- DELIVERABLES -->
<div class="section">
  <div class="wrap">
    <div class="section-ey">What We Deliver</div>
    <div class="section-h2">Documentation infrastructure built to scale.</div>
    <div class="section-sub">From docs-as-code workflows and CI/CD pipelines to documentation portals and automation, we build the engineering foundation your documentation needs.</div>
    <div class="del-grid">
      <div class="del-cat">
        <span class="del-cat-icon">Docs-as-Code & Collaboration</span>
        <div class="del-cat-title">Treat docs like code</div>
        <ul class="del-cat-list">
          <li>Docs-as-Code Implementation</li>
          <li>Git-Based Documentation</li>
          <li>Markdown &amp; MDX</li>
          <li>AsciiDoc</li>
          <li>Version Control</li>
          <li>Branching Strategies</li>
          <li>Pull Request Workflows</li>
          <li>Documentation Reviews</li>
        </ul>
      </div>
      <div class="del-cat">
        <span class="del-cat-icon">Documentation Platforms & Architecture</span>
        <div class="del-cat-title">The right infrastructure for your docs</div>
        <ul class="del-cat-list">
          <li>Documentation Architecture</li>
          <li>Documentation Portals</li>
          <li>Static Documentation Sites</li>
          <li>Multi-Version Documentation</li>
          <li>Search Configuration</li>
          <li>DITA Implementation</li>
          <li>Topic-Based Authoring</li>
          <li>Content Reuse &amp; Single-Sourcing</li>
          <li>Conditional Publishing</li>
          <li>Metadata Management</li>
          <li>Documentation Templates</li>
        </ul>
      </div>
      <div class="del-cat">
        <span class="del-cat-icon">Documentation Automation</span>
        <div class="del-cat-title">Automate the repetitive, focus on the important</div>
        <ul class="del-cat-list">
          <li>CI/CD for Documentation</li>
          <li>Automated Documentation Builds</li>
          <li>Documentation Testing</li>
          <li>Link Validation</li>
          <li>Content Quality Checks</li>
          <li>Publishing Automation</li>
          <li>Release Documentation Automation</li>
          <li>API Documentation Automation</li>
          <li>Documentation Analytics</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- AUDIENCE -->
<div class="section section-alt">
  <div class="wrap">
    <div class="section-ey">Who We Work With</div>
    <div class="section-h2">Built for engineering-led documentation teams.</div>
    <div class="section-sub">Documentation engineering sits at the intersection of writing and software development. We work with teams who want their docs infrastructure to be as robust as their product.</div>
    <div class="aud-grid">
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></div><span class="aud-name">Engineering Teams</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/></svg></div><span class="aud-name">Technical Writers</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div><span class="aud-name">DevOps Teams</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></div><span class="aud-name">Product Teams</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><span class="aud-name">Platform Teams</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div><span class="aud-name">API Teams</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><span class="aud-name">Solution Architects</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></div><span class="aud-name">Enterprise Doc Teams</span></div>
    </div>
  </div>
</div>

<!-- PROCESS -->
<div class="section" style="background:#f0f5ff;">
  <div class="wrap">
    <div class="section-ey">How We Work</div>
    <div class="section-h2">We assess, design, implement, and automate.</div>
    <div class="section-sub">Documentation engineering is not just about choosing a tool. It starts with understanding your team's workflow, then designing and implementing a system that scales with your product.</div>
    <div class="process-grid">
      <div class="process-step">
        <div style="width:40px;height:40px;border-radius:10px;background:#e8f2ff;display:flex;align-items:center;justify-content:center;margin-bottom:16px;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div>
        <div class="process-num">01 / Assess</div>
        <div class="process-title">Understand your current stack</div>
        <div class="process-desc">We review your existing documentation tools, workflows, and pain points to understand what is working, what is not, and what your team actually needs.</div>
      </div>
      <div class="process-step">
        <div style="width:40px;height:40px;border-radius:10px;background:#e8f2ff;display:flex;align-items:center;justify-content:center;margin-bottom:16px;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></div>
        <div class="process-num">02 / Design</div>
