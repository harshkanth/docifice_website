---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Technical Documentation" description="Professional technical documentation services, user guides, admin guides, SOPs, release notes and more. Docifice delivers documentation that works.">

<style>
/* ── Page-level styles ── */
.td-hero{background:#021430;padding:72px 0 64px;position:relative;overflow:hidden;}
.td-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 70% 20%,rgba(0,120,212,.28) 0%,transparent 60%);pointer-events:none;}
.td-hero-inner{max-width:1400px;margin:0 auto;padding:0 32px;position:relative;z-index:2;display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center;}
.td-eyebrow{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#7dd3fc;margin-bottom:14px;}
.td-hero h1{font-size:52px;font-weight:800;color:#fff;letter-spacing:-.04em;line-height:1.04;margin-bottom:18px;}
.td-hero h1 em{font-style:normal;color:#7dd3fc;}
.td-hero p{font-size:16px;color:rgba(255,255,255,.58);line-height:1.76;max-width:480px;margin-bottom:32px;}
.td-hero-btns{display:flex;gap:12px;align-items:center;}
/* Hero visual card */
.td-hero-visual{background:#0a0a0a;border:1px solid rgba(255,255,255,.08);border-radius:16px;overflow:hidden;box-shadow:0 32px 80px rgba(0,0,0,.6);}
.td-hv-bar{background:#111;padding:12px 18px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.06);}
.td-hv-bar-left{display:flex;align-items:center;gap:8px;font-size:11px;color:rgba(255,255,255,.35);font-family:"JetBrains Mono",monospace;}
.td-hv-badge{font-size:9px;font-weight:700;padding:3px 8px;border-radius:4px;background:rgba(52,211,153,.12);color:#34d399;letter-spacing:.04em;text-transform:uppercase;}
.td-hv-body{padding:20px 22px;background:#0a0a0a;}
.td-hv-tag{font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#60b0f4;margin-bottom:6px;}
.td-hv-title{font-size:17px;font-weight:800;color:#fff;margin-bottom:10px;letter-spacing:-.02em;}
.td-hv-text{font-size:12px;color:rgba(255,255,255,.45);line-height:1.65;margin-bottom:16px;}
.td-hv-items{display:flex;flex-direction:column;gap:6px;}
.td-hv-item{display:flex;align-items:center;gap:10px;padding:8px 10px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:7px;}
.td-hv-item-icon{width:22px;height:22px;border-radius:5px;background:rgba(0,120,212,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.td-hv-item-name{font-size:11px;font-weight:600;color:rgba(255,255,255,.75);flex:1;}
.td-hv-item-tag{font-size:9px;color:rgba(255,255,255,.3);font-family:"JetBrains Mono",monospace;}
.td-hv-footer{padding:10px 18px;border-top:1px solid rgba(255,255,255,.06);background:#0a0a0a;display:flex;justify-content:space-between;align-items:center;}
.td-hv-footer-txt{font-size:10px;color:rgba(255,255,255,.3);font-family:"JetBrains Mono",monospace;}

/* Trust bar */
.trust-bar{background:#f8f9fa;border-bottom:1px solid #f0f0f0;padding:20px 0;}
.trust-bar-inner{max-width:1400px;margin:0 auto;padding:0 32px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;}
.trust-label{font-size:13px;font-weight:700;color:#0a0a0a;white-space:nowrap;}
.trust-items{display:flex;flex:1;justify-content:space-between;flex-wrap:wrap;align-items:center;margin-left:32px;}
.trust-item{font-size:13px;font-weight:600;color:#555;display:flex;align-items:center;gap:6px;}
.trust-item svg{color:#0078D4;}

/* Section base */
.section{padding:88px 0;}
.section-alt{background:#f8f9fa;}
.wrap{max-width:1400px;margin:0 auto;padding:0 32px;}
.section-ey{font-size:11px;font-weight:700;letter-spacing:.04em;color:#0078D4;margin-bottom:12px;}
.section-h2{font-size:36px;font-weight:800;letter-spacing:-.04em;color:#0a0a0a;line-height:1.1;margin-bottom:14px;}
.section-sub{font-size:15px;color:#666;line-height:1.6;}

/* Deliverables — 2-col grid with bullet lists */
.del-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;margin-top:40px;}
.del-cat:nth-child(1){grid-column:span 2;}
.del-cat:nth-child(2){grid-column:span 2;}
.del-cat:nth-child(3){grid-column:span 2;}
.del-cat:nth-child(4){grid-column:2/span 2;}
.del-cat:nth-child(5){grid-column:span 2;}
.del-cat{border-radius:12px;padding:24px 26px;border:1px solid #eaecf0;border-top:3px solid #0078D4;background:#fff;transition:border-color .2s,box-shadow .2s,transform .22s cubic-bezier(.34,1.1,.64,1);}
.del-cat:hover{border-color:#c8ddf5;box-shadow:0 6px 20px rgba(0,120,212,.08);transform:translateY(-3px);}
.del-cat-icon{font-size:10px;font-weight:700;letter-spacing:.05em;color:#0078D4;margin-bottom:6px;display:block;}
.del-cat-title{font-size:15px;font-weight:800;color:#0a0a0a;letter-spacing:-.02em;margin-bottom:12px;}
.del-cat-list{list-style:none;display:flex;flex-direction:column;gap:6px;}
.del-cat-list li{font-size:12px;color:#444;padding-left:14px;position:relative;line-height:1.5;}
.del-cat-list li::before{content:'';position:absolute;left:0;top:6px;width:5px;height:5px;border-radius:50%;background:#0078D4;}

/* Industries */
.ind-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:48px;}
.ind-card{background:#fff;border:1px solid #eaecf0;border-radius:10px;padding:20px;display:flex;align-items:center;gap:12px;transition:border-color .2s,box-shadow .2s,transform .22s cubic-bezier(.34,1.1,.64,1);}
.ind-card:hover{border-color:#0078D4;box-shadow:0 6px 20px rgba(0,120,212,.1);transform:translateY(-3px);}
.ind-icon{width:32px;height:32px;border-radius:8px;background:#f0f5ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.ind-name{font-size:13px;font-weight:600;color:#0a0a0a;}

/* Process */
.process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:40px;}
.process-step{background:#fff;padding:28px 24px;}
.process-num{font-size:11px;font-weight:700;color:#0078D4;letter-spacing:.04em;margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.process-title{font-size:16px;font-weight:800;color:#0a0a0a;margin-bottom:8px;letter-spacing:-.02em;}
.process-desc{font-size:13px;color:#666;line-height:1.65;}

/* Why us */
.why-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;}
.why-list{display:flex;flex-direction:column;gap:20px;margin-top:32px;}
.why-item{display:flex;gap:16px;align-items:flex-start;}
.why-item-icon{width:40px;height:40px;border-radius:10px;background:#f0f5ff;border:1px solid rgba(0,120,212,.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.why-item-title{font-size:15px;font-weight:700;color:#0a0a0a;margin-bottom:4px;}
.why-item-desc{font-size:13px;color:#666;line-height:1.65;}
.why-visual{background:#0f172a;border-radius:16px;padding:36px;position:relative;overflow:hidden;}
.why-visual::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 80% 20%,rgba(0,120,212,.2) 0%,transparent 60%);}
.why-stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;position:relative;z-index:1;}
.why-stat{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:20px;}
.why-stat-num{font-size:28px;font-weight:800;color:#fff;letter-spacing:-.04em;margin-bottom:4px;}
.why-stat-num span{color:#7dd3fc;}
.why-stat-lbl{font-size:11px;color:rgba(255,255,255,.5);}

/* Tools */
.tools-grid{display:flex;flex-wrap:wrap;gap:10px;margin-top:32px;}
.td-tools .tool-tag{background:rgba(255,255,255,.07);color:rgba(255,255,255,.8);border:1px solid rgba(255,255,255,.1);}
.td-tools .tool-tag:hover{background:rgba(0,120,212,.2);border-color:rgba(0,120,212,.4);color:#fff;}
.tool-tag{font-size:12px;font-weight:600;padding:7px 14px;border-radius:8px;background:rgba(255,255,255,.07);color:rgba(255,255,255,.8);border:1px solid rgba(255,255,255,.1);transition:background .2s,color .2s,border-color .2s;}
.tool-tag:hover{background:rgba(0,120,212,.2);border-color:rgba(0,120,212,.4);color:#fff;}

/* FAQs */
.faq-list{display:flex;flex-direction:column;gap:2px;margin-top:48px;}
.faq-item{border:1px solid #eaecf0;border-radius:10px;overflow:hidden;}
.faq-q{padding:20px 24px;font-size:15px;font-weight:600;color:#0a0a0a;cursor:pointer;display:flex;justify-content:space-between;align-items:center;user-select:none;}
.faq-q:hover{background:#f8f9fa;}
.faq-a{padding:0 24px 0;font-size:14px;color:#555;line-height:1.74;max-height:0;overflow:hidden;transition:max-height .35s ease,padding .35s ease;}
.faq-item.open .faq-a{max-height:200px;padding:0 24px 20px;}
.faq-item.open .faq-chevron{transform:rotate(180deg);}
.faq-chevron{transition:transform .2s;flex-shrink:0;color:#0078D4;}



/* Buttons */
.btn-primary{all:unset;box-sizing:border-box;display:inline-flex;align-items:center;gap:8px;background:#0078D4;color:#fff;padding:13px 28px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;transition:transform .22s cubic-bezier(.34,1.1,.64,1),box-shadow .22s,opacity .2s;}
.btn-primary:hover{opacity:.88;transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,120,212,.3);}
.btn-ghost{all:unset;box-sizing:border-box;display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);color:#fff;border:1.5px solid rgba(255,255,255,.3);padding:12px 24px;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;transition:background .2s,transform .22s cubic-bezier(.34,1.1,.64,1);}
.btn-ghost:hover{background:rgba(255,255,255,.2);transform:translateY(-2px);}
.btn-outline{all:unset;box-sizing:border-box;display:inline-flex;align-items:center;gap:8px;background:#fff;color:#0a0a0a;border:1.5px solid #d0d0d0;padding:12px 24px;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;transition:border-color .2s,transform .22s cubic-bezier(.34,1.1,.64,1);}
.btn-outline:hover{border-color:#0078D4;color:#0078D4;transform:translateY(-2px);}
</style>

<!-- HERO -->
<div class="td-hero">
  <div class="td-hero-inner">
    <div>
      <div class="td-eyebrow">Technical Documentation</div>
      <h1>Documentation that makes your product <em>easy to use.</em></h1>
      <p>We go beyond writing. We test your product, understand your users, and deliver documentation that reduces support tickets, accelerates onboarding, and builds user confidence.</p>
      <div class="td-hero-btns">
        <a href="/contact" class="btn-primary">Get in touch <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/work/case-studies" class="btn-ghost">View case studies <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
      </div>
    </div>
    <!-- Hero visual: real document page mockup -->
    <div style="position:relative;">
      <div style="background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 32px 80px rgba(0,0,0,.5);border:1px solid rgba(255,255,255,.1);">

        <!-- Doc header bar -->
        <div style="background:#f7f8fa;padding:10px 20px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ebebeb;">
          <div style="display:flex;align-items:center;gap:8px;">
            <div style="width:8px;height:8px;border-radius:50%;background:#e0e0e0;"></div>
            <div style="width:8px;height:8px;border-radius:50%;background:#e0e0e0;"></div>
            <div style="width:8px;height:8px;border-radius:50%;background:#e0e0e0;"></div>
          </div>
          <span style="font-size:11px;color:#aaa;font-family:'JetBrains Mono',monospace;">User Guide v4.2</span>
          <div style="width:50px;"></div>
        </div>

        <!-- Document body -->
        <div style="display:grid;grid-template-columns:180px 1fr;">

          <!-- Sidebar TOC -->
          <div style="background:#f9fafb;border-right:1px solid #ebebeb;padding:20px 14px;">
            <div style="font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#bbb;margin-bottom:12px;">Contents</div>
            <div style="display:flex;flex-direction:column;gap:4px;">
              <div style="font-size:11px;color:#888;padding:4px 8px;border-radius:5px;">Overview</div>
              <div style="font-size:11px;color:#888;padding:4px 8px;border-radius:5px;">Getting Started</div>
              <div style="font-size:11px;font-weight:600;color:#0078D4;padding:4px 8px;border-radius:5px;background:#e8f2ff;">Configuration</div>
              <div style="font-size:11px;color:#888;padding:4px 8px;border-radius:5px;padding-left:16px;">3.1 Settings</div>
              <div style="font-size:11px;color:#888;padding:4px 8px;border-radius:5px;padding-left:16px;">3.2 Permissions</div>
              <div style="font-size:11px;color:#888;padding:4px 8px;border-radius:5px;">Troubleshooting</div>
              <div style="font-size:11px;color:#888;padding:4px 8px;border-radius:5px;">FAQs</div>
            </div>
          </div>

          <!-- Main content -->
          <div style="padding:20px 22px;background:#fff;">
            <div style="font-size:14px;font-weight:700;color:#0a0a0a;margin-bottom:6px;letter-spacing:-.01em;">Configure General Settings</div>
            <div style="font-size:11px;color:#555;line-height:1.65;margin-bottom:10px;">To update the organisation name or timezone, perform the following steps.</div>

            <!-- Steps -->
            <div style="display:flex;flex-direction:column;gap:7px;margin-bottom:12px;">
              <div style="display:flex;gap:10px;align-items:flex-start;">
                <div style="width:18px;height:18px;border-radius:4px;background:#0078D4;color:#fff;font-size:9px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">1</div>
                <div style="font-size:11px;color:#333;line-height:1.55;">Go to <strong style="color:#0a0a0a;">Settings</strong> and select <strong style="color:#0a0a0a;">General</strong>.</div>
              </div>
              <div style="display:flex;gap:10px;align-items:flex-start;">
                <div style="width:18px;height:18px;border-radius:4px;background:#0078D4;color:#fff;font-size:9px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">2</div>
                <div style="font-size:11px;color:#333;line-height:1.55;">Enter the organisation name and select a timezone.</div>
              </div>
              <div style="display:flex;gap:10px;align-items:flex-start;">
                <div style="width:18px;height:18px;border-radius:4px;background:#0078D4;color:#fff;font-size:9px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">3</div>
                <div style="font-size:11px;color:#333;line-height:1.55;">Select <strong style="color:#0a0a0a;">Save</strong>.</div>
              </div>
            </div>

            <!-- Note callout — SAP/MSTP style -->
            <div style="background:#f0f5ff;border-left:3px solid #0078D4;border-radius:0 6px 6px 0;padding:8px 12px;display:flex;gap:8px;">
              <span style="font-size:9px;font-weight:700;color:#0078D4;flex-shrink:0;margin-top:1px;">Note</span>
              <span style="font-size:10px;color:#333;line-height:1.55;">Timezone changes affect all users. Inform your team before saving.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- TRUST BAR -->
<div class="trust-bar">
  <div class="trust-bar-inner">
    <span class="trust-label">Trusted By</span>
    <div class="trust-items">
      <span class="trust-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Enterprise SaaS teams</span>
      <span class="trust-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Fortune 500 companies</span>
      <span class="trust-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Global product teams</span>
      <span class="trust-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>High-growth startups</span>
      <span class="trust-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>11+ years of expertise</span>
    </div>
  </div>
</div>

<!-- DELIVERABLES -->
<div class="section">
  <div class="wrap">
    <div class="section-ey">What We Deliver</div>
    <div class="section-h2">Every type of technical document,<br>done right.</div>
    <div class="section-sub">From first-time user guides to enterprise-grade compliance documentation, we cover the full spectrum. Whatever your industry calls it, whether an instruction handbook, operator manual, commissioning guide, field service manual, or regulatory document, we know the convention and we deliver to that standard.</div>

    <div class="del-grid">
      <div class="del-cat">
        <span class="del-cat-icon">Core Documentation</span>
        <div class="del-cat-title">The foundation of every product</div>
        <ul class="del-cat-list">
          <li>User Guides</li><li>Administrator Guides</li><li>Installation Guides</li><li>Configuration Guides</li><li>Implementation Guides</li><li>Deployment Guides</li><li>Operations Manuals</li><li>Maintenance Manuals</li>
        </ul>
      </div>
      <div class="del-cat">
        <span class="del-cat-icon">Product & Software</span>
        <div class="del-cat-title">Built for how software ships</div>
        <ul class="del-cat-list">
          <li>Product Documentation</li><li>Feature Documentation</li><li>System Documentation</li><li>Technical Specifications</li><li>Functional Specifications</li><li>Architecture Documentation</li><li>Design Documentation</li>
        </ul>
      </div>
      <div class="del-cat">
        <span class="del-cat-icon">Process & Operations</span>
        <div class="del-cat-title">Clarity for every workflow</div>
        <ul class="del-cat-list">
          <li>SOPs</li><li>Work Instructions</li><li>Process Documentation</li><li>Runbooks</li><li>Playbooks</li><li>Troubleshooting Guides</li><li>Knowledge Base Articles</li><li>FAQs</li>
        </ul>
      </div>
      <div class="del-cat">
        <span class="del-cat-icon">Release & Support</span>
        <div class="del-cat-title">Keep users in the loop</div>
        <ul class="del-cat-list">
          <li>Release Notes</li><li>Known Issues</li><li>Change Logs</li><li>Upgrade &amp; Migration Guides</li><li>Disaster Recovery Docs</li><li>Backup &amp; Recovery Procedures</li>
        </ul>
      </div>
      <div class="del-cat">
        <span class="del-cat-icon">Enterprise</span>
        <div class="del-cat-title">Documentation at scale</div>
        <ul class="del-cat-list">
          <li>Policy Documentation</li><li>Compliance Documentation</li><li>Security Documentation</li><li>Governance Documentation</li><li>Training Manuals</li><li>Onboarding Guides</li><li>Internal Documentation</li><li>Operational Documentation</li>
        </ul>
      </div>
    </div>


  </div>
</div>

<!-- INDUSTRIES -->
<div class="section section-alt">
  <div class="wrap">
    <div class="section-ey">Industries We Serve</div>
    <div class="section-h2">We've documented across every major industry.</div>
    <div class="section-sub">11+ years working inside enterprise software, regulated industries, and high-growth product companies. We adapt fast, no ramp-up time.</div>

    <div class="ind-grid" style="grid-template-columns:repeat(5,1fr);">
      <div class="ind-card"><div class="ind-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></div><span class="ind-name">Enterprise Software &amp; SaaS</span></div>
      <div class="ind-card"><div class="ind-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><span class="ind-name">FinTech &amp; Finance</span></div>
