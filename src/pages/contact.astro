---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Docifice | Technical Writing Agency" description="Get in touch with Docifice. Tell us about your documentation project and we will get back to you within one business day.">

<style>
.contact-hero{background:#021430;padding:64px 0 56px;position:relative;overflow:hidden;}
.contact-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 80% 20%,rgba(0,120,212,.22) 0%,transparent 60%);pointer-events:none;}
.contact-hero-inner{max-width:1400px;margin:0 auto;padding:0 32px;position:relative;z-index:2;}
.contact-eyebrow{font-size:11px;font-weight:700;letter-spacing:.04em;color:#7dd3fc;margin-bottom:12px;}
.contact-hero h1{font-size:48px;font-weight:800;color:#fff;letter-spacing:-.04em;line-height:1.06;margin-bottom:16px;}
.contact-hero h1 em{font-style:normal;color:#7dd3fc;}
.contact-links{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:24px;}
.contact-social{display:flex;gap:8px;}
.contact-social a{width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.22);border-radius:10px;color:#fff;background:rgba(255,255,255,.06);transition:background .2s,border-color .2s;}
.contact-social a:hover{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.4);}
.contact-mail{display:inline-flex;align-items:center;gap:10px;margin:0;padding:11px 18px;border:1px solid rgba(255,255,255,.22);border-radius:10px;color:#fff;font-size:15px;font-weight:600;text-decoration:none;background:rgba(255,255,255,.06);transition:background .2s,border-color .2s;}
.contact-mail:hover{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.4);}
.contact-mail span{font-size:12px;font-weight:500;color:rgba(255,255,255,.6);}
.contact-hero p{font-size:16px;color:rgba(255,255,255,.55);line-height:1.7;max-width:520px;}

.contact-body{background:#f8f9fa;padding:72px 0;}
.contact-inner{max-width:1400px;margin:0 auto;padding:0 32px;display:grid;grid-template-columns:1fr 1.4fr;gap:48px;align-items:start;}

/* Left: form + info */
.contact-left{display:flex;flex-direction:column;}
.form-card{background:#fff;border-radius:16px;padding:40px;border:1px solid #eaecf0;}
.form-card h2{font-size:22px;font-weight:800;color:#0a0a0a;letter-spacing:-.03em;margin-bottom:6px;}
.form-card p{font-size:14px;color:#888;line-height:1.6;margin-bottom:28px;}
.form-group{display:flex;flex-direction:column;gap:6px;margin-bottom:20px;}
.form-group label{font-size:13px;font-weight:600;color:#0a0a0a;}
.form-group input,.form-group textarea,.form-group select{font-family:'Plus Jakarta Sans',sans-serif;font-size:14px;color:#0a0a0a;background:#f8f9fa;border:1.5px solid #e4e8f0;border-radius:8px;padding:12px 14px;outline:none;transition:border-color .2s,box-shadow .2s;resize:none;}
.form-group input:focus,.form-group textarea:focus,.form-group select:focus{border-color:#0078D4;box-shadow:0 0 0 3px rgba(0,120,212,.1);background:#fff;}
.form-group textarea{height:130px;}
.form-submit{width:100%;background:#0078D4;color:#fff;border:none;border-radius:8px;padding:14px;font-family:'Plus Jakarta Sans',sans-serif;font-size:15px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:opacity .2s,transform .22s cubic-bezier(.34,1.1,.64,1),box-shadow .22s;}
.form-submit:hover{opacity:.9;transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,120,212,.3);}

/* Right: Calendly */
.cal-card{background:#fff;border-radius:16px;padding:32px 32px 0;border:1px solid #eaecf0;overflow:hidden;}
.cal-card h2{font-size:22px;font-weight:800;color:#0a0a0a;letter-spacing:-.03em;margin-bottom:6px;}
.cal-card p{font-size:14px;color:#888;line-height:1.6;margin-bottom:24px;}
.calendly-embed{border-radius:0 0 16px 16px;overflow:hidden;margin:0 -32px;}
</style>

<!-- HERO -->
<div class="contact-hero">
  <div class="contact-hero-inner">
    <div class="contact-eyebrow">Get in touch</div>
    <h1>Let's talk about your <em>documentation.</em></h1>
    <p>Tell us what you are working on. Send a message, book a call, or write to us directly.</p>
    <div class="contact-links">
      <a class="contact-mail" href="mailto:hello@docifice.com"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>hello@docifice.com</a>
      <div class="contact-social">
        <a href="https://www.linkedin.com/company/docifice/" target="_blank" rel="noopener" aria-label="Docifice on LinkedIn"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
        <a href="https://x.com/Docifice" target="_blank" rel="noopener" aria-label="Docifice on X"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
        <a href="https://www.instagram.com/docifice/" target="_blank" rel="noopener" aria-label="Docifice on Instagram"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
      </div>
    </div>
  </div>
</div>

<!-- BODY -->
<div class="contact-body">
  <div class="contact-inner">

    <!-- LEFT: Form + info -->
    <div class="contact-left">
      <div class="form-card">
        <h2>Send us a message</h2>
        <p>Prefer to write first? Fill in your details and we will get back to you.</p>
        <form name="contact" method="POST" data-netlify="true" action="/contact-success">
          <input type="hidden" name="form-name" value="contact" />
          <div class="form-group">
            <label for="name">Your name</label>
            <input type="text" id="name" name="name" placeholder="Your full name" required />
          </div>
          <div class="form-group">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" placeholder="you@company.com" required />
          </div>
          <div class="form-group">
            <label for="need">What do you need?</label>
            <select id="need" name="need">
              <option value="Not sure yet">Not sure yet</option>
              <option value="End-to-end documentation">End-to-end documentation</option>
              <option value="An embedded writer">An embedded writer</option>
              <option value="Hiring a technical writer">Hiring a technical writer</option>
              <option value="A specific documentation project">A specific documentation project</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">What are you working on?</label>
            <textarea id="message" name="message" placeholder="Tell us about your project, what you need, and any relevant details..." required></textarea>
          </div>
          <button type="submit" class="form-submit">
            Send message
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </form>
      </div>

    </div>

    <!-- RIGHT: Calendly -->
    <div class="contact-right">
      <div class="cal-card">
        <h2>Book a call</h2>
        <p>Prefer to talk? Pick a time that works for you and we will talk through what you need in a 30-minute call.</p>
        <div class="calendly-embed">
          <div class="calendly-inline-widget" data-url="https://calendly.com/harsh-docifice/30min?hide_event_type_details=1&hide_gdpr_banner=1&primary_color=0078D4" style="min-width:320px;height:650px;"></div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- WAVES -->
<div class="bottom" style="padding-top:0;margin-top:0;">
  <canvas id="waveCanvas"></canvas>
</div>

<script>
const wc=document.getElementById('waveCanvas');
const wx=wc&&wc.getContext('2d');
function resize(){if(!wc)return;wc.width=wc.offsetWidth;wc.height=200;}
resize();window.addEventListener('resize',resize);
const layers=[
  {a:20,s:.0009,c1:'#b8d0e8',c2:'#88b0d0',y:0.44,o:.5,p:0},
  {a:18,s:.0007,c1:'#4888c0',c2:'#0078D4',y:0.54,o:.62,p:1.8},
  {a:18,s:.0011,c1:'#0060a8',c2:'#004880',y:0.65,o:.72,p:3.2},
  {a:16,s:.0006,c1:'#003060',c2:'#002040',y:0.75,o:.82,p:0.9},
  {a:14,s:.0013,c1:'#011828',c2:'#021430',y:0.85,o:.93,p:2.1},
  {a:10,s:.0005,c1:'#010e20',c2:'#010e20',y:0.93,o:1,p:1.2},
];
function draw(t){
  if(!wx||!wc)return;
  const W=wc.width,H=wc.height;
  wx.clearRect(0,0,W,H);
  wx.fillStyle='#f8f9fa';wx.fillRect(0,0,W,H);
  layers.forEach(l=>{
    wx.beginPath();
    const by=H*l.y;wx.moveTo(0,H);
    for(let x=0;x<=W;x+=2){
      const n=x/W;
      const raw=by+Math.sin(n*Math.PI*3.5+t*l.s+l.p)*l.a+Math.sin(n*Math.PI*6+t*l.s*.65+l.p*1.4)*l.a*.35;
      wx.lineTo(x,Math.max(by-l.a*1.45,raw));
    }
    wx.lineTo(W,H);wx.closePath();
    const g=wx.createLinearGradient(0,0,W,0);
    g.addColorStop(0,l.c1);g.addColorStop(1,l.c2);
    wx.fillStyle=g;wx.globalAlpha=l.o;wx.fill();
  });
  wx.globalAlpha=1;requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>

<script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>

</BaseLayout>
