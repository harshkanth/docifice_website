---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Get in Touch" description="Get in touch with Docifice. Tell us about your documentation project and we will get back to you within one business day.">

<style>
.contact-hero{background:#021430;padding:64px 0 56px;position:relative;overflow:hidden;}
.contact-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 80% 20%,rgba(0,120,212,.22) 0%,transparent 60%);pointer-events:none;}
.contact-hero-inner{max-width:1400px;margin:0 auto;padding:0 32px;position:relative;z-index:2;}
.contact-eyebrow{font-size:11px;font-weight:700;letter-spacing:.04em;color:#7dd3fc;margin-bottom:12px;}
.contact-hero h1{font-size:48px;font-weight:800;color:#fff;letter-spacing:-.04em;line-height:1.06;margin-bottom:16px;}
.contact-hero h1 em{font-style:normal;color:#7dd3fc;}
.contact-hero p{font-size:16px;color:rgba(255,255,255,.55);line-height:1.7;max-width:520px;}

.contact-body{background:#f8f9fa;padding:72px 0;}
.contact-inner{max-width:1400px;margin:0 auto;padding:0 32px;display:grid;grid-template-columns:1fr 1.4fr;gap:48px;align-items:start;}

/* Left: form + info */
.contact-left{}
.form-card{background:#fff;border-radius:16px;padding:40px;border:1px solid #eaecf0;margin-bottom:24px;}
.form-card h2{font-size:22px;font-weight:800;color:#0a0a0a;letter-spacing:-.03em;margin-bottom:6px;}
.form-card p{font-size:14px;color:#888;line-height:1.6;margin-bottom:28px;}
.form-group{display:flex;flex-direction:column;gap:6px;margin-bottom:20px;}
.form-group label{font-size:13px;font-weight:600;color:#0a0a0a;}
.form-group input,.form-group textarea{font-family:'Plus Jakarta Sans',sans-serif;font-size:14px;color:#0a0a0a;background:#f8f9fa;border:1.5px solid #e4e8f0;border-radius:8px;padding:12px 14px;outline:none;transition:border-color .2s,box-shadow .2s;resize:none;}
.form-group input:focus,.form-group textarea:focus{border-color:#0078D4;box-shadow:0 0 0 3px rgba(0,120,212,.1);background:#fff;}
.form-group textarea{height:130px;}
.form-submit{width:100%;background:#0078D4;color:#fff;border:none;border-radius:8px;padding:14px;font-family:'Plus Jakarta Sans',sans-serif;font-size:15px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:opacity .2s,transform .22s cubic-bezier(.34,1.1,.64,1),box-shadow .22s;}
.form-submit:hover{opacity:.9;transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,120,212,.3);}

/* Info tiles below form */
.info-tiles{display:flex;flex-direction:column;gap:12px;}
.info-tile{background:#fff;border:1px solid #eaecf0;border-radius:12px;padding:16px 20px;display:flex;gap:14px;align-items:center;}
.info-tile-icon{width:36px;height:36px;border-radius:9px;background:#f0f5ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.info-tile-label{font-size:11px;font-weight:700;color:#0078D4;margin-bottom:4px;letter-spacing:.02em;}
.info-tile-value{font-size:13px;font-weight:600;color:#0a0a0a;line-height:1.4;}
.info-tile-sub{font-size:11px;color:#888;margin-top:2px;}

/* Right: Calendly */
.contact-right{}
.cal-card{background:#fff;border-radius:16px;padding:32px 32px 0;border:1px solid #eaecf0;overflow:hidden;}
.cal-card h2{font-size:22px;font-weight:800;color:#0a0a0a;letter-spacing:-.03em;margin-bottom:6px;}
.cal-card p{font-size:14px;color:#888;line-height:1.6;margin-bottom:24px;}
.calendly-embed{border-radius:0 0 16px 16px;overflow:hidden;margin:0 -32px;}
</style>

<!-- HERO -->
<div class="contact-hero">
  <div class="contact-hero-inner">
    <div class="contact-eyebrow">Get in Touch</div>
    <h1>Let's talk about your <em>documentation.</em></h1>
    <p>Tell us what you are working on. We will get back to you within one business day — no templates, no runaround. Just a direct conversation about your project.</p>
  </div>
</div>

<!-- BODY -->
<div class="contact-body">
  <div class="contact-inner">

    <!-- LEFT: Form + info -->
    <div class="contact-left">
      <div class="form-card">
        <h2>Send us a message</h2>
        <p>Prefer to write first? Fill in your details and we will be in touch.</p>
        <form name="contact" method="POST" data-netlify="true" action="/contact-success">
          <div class="form-group">
            <label for="name">Your name</label>
            <input type="text" id="name" name="name" placeholder="Your full name" required />
          </div>
          <div class="form-group">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" placeholder="you@company.com" required />
          </div>
          <div class="form-group">
            <label for="message">What are you working on?</label>
            <textarea id="message" name="message" placeholder="Tell us about your project, what you need, and any relevant details..." required></textarea>
          </div>
          <button type="submit" class="form-submit">
            Send message
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </form>
      </div>

      <!-- Info tiles -->
      <div class="info-tiles">
        <div class="info-tile">
          <div class="info-tile-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div>
            <div class="info-tile-label">Email</div>
            <div class="info-tile-value">hello@docifice.com</div>
            
          </div>
        </div>
        <div class="info-tile">
          <div class="info-tile-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <div class="info-tile-label">Response time</div>
            <div class="info-tile-value">Within 24 hours</div>
            
          </div>
        </div>
        <div class="info-tile">
          <div class="info-tile-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <div class="info-tile-label">Book a call</div>
            <div class="info-tile-value">30-min discovery</div>
            
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Calendly -->
    <div class="contact-right">
      <div class="cal-card">
        <h2>Book a discovery call</h2>
        <p>Prefer to talk? Pick a time that works for you and we will connect for a 30-minute discovery call.</p>
        <div class="calendly-embed">
          <div class="calendly-inline-widget" data-url="https://calendly.com/docifice/discovery?hide_event_type_details=1&hide_gdpr_banner=1&primary_color=0078D4" style="min-width:320px;height:650px;"></div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- WAVES -->
<div class="bottom" style="padding-top:0;margin-top:0;">
  <canvas id="waveCanvas"></canvas>
</div>

<script>
const wc=document.getElementById('waveCanvas');
const wx=wc&&wc.getContext('2d');
function resize(){if(!wc)return;wc.width=wc.offsetWidth;wc.height=200;}
resize();window.addEventListener('resize',resize);
const layers=[
  {a:20,s:.0009,c1:'#b8d0e8',c2:'#88b0d0',y:0.44,o:.5,p:0},
  {a:18,s:.0007,c1:'#4888c0',c2:'#0078D4',y:0.54,o:.62,p:1.8},
  {a:18,s:.0011,c1:'#0060a8',c2:'#004880',y:0.65,o:.72,p:3.2},
  {a:16,s:.0006,c1:'#003060',c2:'#002040',y:0.75,o:.82,p:0.9},
  {a:14,s:.0013,c1:'#011828',c2:'#021430',y:0.85,o:.93,p:2.1},
  {a:10,s:.0005,c1:'#010e20',c2:'#010e20',y:0.93,o:1,p:1.2},
];
function draw(t){
  if(!wx||!wc)return;
  const W=wc.width,H=wc.height;
  wx.clearRect(0,0,W,H);
  wx.fillStyle='#f8f9fa';wx.fillRect(0,0,W,H);
  layers.forEach(l=>{
    wx.beginPath();
    const by=H*l.y;wx.moveTo(0,H);
    for(let x=0;x<=W;x+=2){
      const n=x/W;
      const raw=by+Math.sin(n*Math.PI*3.5+t*l.s+l.p)*l.a+Math.sin(n*Math.PI*6+t*l.s*.65+l.p*1.4)*l.a*.35;
      wx.lineTo(x,Math.max(by-l.a*1.45,raw));
    }
    wx.lineTo(W,H);wx.closePath();
    const g=wx.createLinearGradient(0,0,W,0);
    g.addColorStop(0,l.c1);g.addColorStop(1,l.c2);
    wx.fillStyle=g;wx.globalAlpha=l.o;wx.fill();
  });
  wx.globalAlpha=1;requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>

<script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>

</BaseLayout>
