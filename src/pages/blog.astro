---
import BaseLayout from '../layouts/BaseLayout.astro';
import { posts, categories } from '../data/posts';
const labels = Object.fromEntries(categories.map((c) => [c.key, c.label]));
const PER_PAGE = 6;
---

<BaseLayout title="Blog" description="Practical articles on technical documentation, working with writers, API documentation and hiring, from the Docifice team.">

<style>
.blog-hero{background:linear-gradient(90deg,rgba(8,14,28,.88) 0%,rgba(8,14,28,.7) 55%,rgba(8,14,28,.35) 100%),url('/images/blog-cover.jpg') center/cover no-repeat;padding:96px 0 80px;border-bottom:1px solid #e8eef7;}
.blog-hero-inner{max-width:1400px;margin:0 auto;padding:0 32px;}
.blog-eyebrow{font-size:11px;font-weight:700;letter-spacing:.04em;color:#7cc0ff;margin-bottom:16px;}
.blog-hero h1{font-size:56px;font-weight:800;letter-spacing:-.04em;line-height:1.04;margin-bottom:16px;max-width:700px;color:#fff;}
.blog-hero h1 em{font-style:normal;color:#7cc0ff;}
.blog-hero p{font-size:17px;color:#e3ebf6;line-height:1.7;max-width:520px;}


.bl-tools{background:#fff;border-bottom:1px solid #eef2f8;padding:20px 0 14px;}
.bl-tools-inner{max-width:1240px;margin:0 auto;padding:0 32px;display:grid;grid-template-columns:1fr 280px;gap:14px;}
.bl-search,.bl-select{display:flex;align-items:center;gap:10px;background:#fff;border:1.5px solid #d8e2f0;border-radius:10px;padding:0 14px;height:48px;transition:border-color .15s;}
.bl-search:focus-within,.bl-select:focus-within{border-color:#0078D4;}
.bl-search svg{flex-shrink:0;color:#777;}
.bl-search input{flex:1;min-width:0;border:0;outline:0;background:transparent;font:500 15px "Plus Jakarta Sans",sans-serif;color:#0a0a0a;height:100%;}
.bl-select span{font-size:12px;font-weight:700;color:#777;white-space:nowrap;}
.bl-select select{flex:1;min-width:0;border:0;outline:0;background:transparent;font:600 14px "Plus Jakarta Sans",sans-serif;color:#0a0a0a;height:100%;cursor:pointer;}
.bl-status{max-width:1240px;margin:12px auto 0;padding:0 32px;display:flex;align-items:center;gap:14px;font-size:13px;color:#666;min-height:22px;}
.bl-clear{all:unset;font:700 13px "Plus Jakarta Sans",sans-serif;color:#0078D4;cursor:pointer;}
.bl-clear:hover{text-decoration:underline;}
.bl-clear[hidden]{display:none;}

.bl-body{background:#f8f9fa;padding:36px 0 48px;}
.bl-inner{max-width:1240px;margin:0 auto;padding:0 32px;}
.bl-list{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
.bl-item{display:flex;flex-direction:column;background:#fff;border:1.5px solid #eaecf0;border-radius:14px;overflow:hidden;transition:border-color .2s,box-shadow .2s,transform .22s cubic-bezier(.34,1.1,.64,1);}
.bl-item:hover{border-color:#0078D4;box-shadow:0 10px 28px rgba(0,120,212,.1);transform:translateY(-3px);}
.bl-item[hidden]{display:none;}
.bl-thumb{display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;height:170px;text-decoration:none;}
.bl-thumb::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 30% 40%,rgba(0,120,212,.32) 0%,transparent 65%);}
.bl-thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
.bl-thumb-word{position:relative;z-index:2;font-size:34px;font-weight:800;color:rgba(255,255,255,.22);letter-spacing:-.03em;}
.bl-main{padding:22px 24px;display:flex;flex-direction:column;flex:1;}
.bl-cats{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;}
.bl-cat{all:unset;cursor:pointer;font:700 11px "Plus Jakarta Sans",sans-serif;letter-spacing:.03em;color:#0078D4;background:#f0f5ff;border-radius:6px;padding:4px 9px;}
.bl-cat:hover,.bl-cat:focus-visible{background:#0078D4;color:#fff;}
.bl-main h2{font-size:18px;font-weight:800;letter-spacing:-.02em;line-height:1.3;margin:0 0 8px;}
.bl-main h2 a{color:#0a0a0a;text-decoration:none;}
.bl-main h2 a:hover{color:#0078D4;}
.bl-main p{font-size:13.5px;color:#555;line-height:1.65;margin:0 0 14px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;}
.bl-meta{margin-top:auto;font-size:12.5px;color:#888;}
.bl-empty{background:#fff;border:1.5px dashed #d8e2f0;border-radius:14px;padding:48px 24px;text-align:center;color:#555;font-size:15px;line-height:1.7;}
.bl-empty[hidden]{display:none;}
@media(max-width:1000px){.bl-list{grid-template-columns:repeat(2,1fr);}}
@media(max-width:760px){
  .bl-tools-inner{grid-template-columns:1fr;padding:0 20px;}
  .bl-status{padding:0 20px;}
  .bl-inner{padding:0 20px;}
  .bl-list{grid-template-columns:1fr;}
  .bl-thumb{height:130px;}
  .bl-main{padding:20px;}
  .blog-hero h1{font-size:36px;}
}
.wrap{max-width:1400px;margin:0 auto;padding:0 32px;}
.bottom{background:#f8f9fa;padding:16px 0 0;position:relative;overflow:hidden;}
.cta{text-align:center;padding-bottom:40px;position:relative;z-index:2;}
.cta-eyebrow{font-size:11px;font-weight:700;letter-spacing:.02em;color:#0078D4;margin-bottom:16px;}
.cta-h2{font-size:40px;font-weight:800;letter-spacing:-.04em;color:#0a0a0a;margin-bottom:16px;line-height:1.1;}
.cta-h2 em{font-style:normal;color:#0078D4;}
.cta-sub{font-size:16px;color:#555;line-height:1.7;max-width:520px;margin:0 auto 32px;}
.cta-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;}
canvas#waveCanvas{width:100%;height:200px;display:block;position:relative;z-index:1;}
</style>
<style is:global>
.bl-pager{display:flex;justify-content:center;align-items:center;gap:8px;margin-top:32px;flex-wrap:wrap;}
.bl-pager[hidden]{display:none;}
.bl-pg{-webkit-appearance:none;appearance:none;box-sizing:border-box;min-width:40px;height:40px;margin:0;padding:0 14px;display:inline-flex;align-items:center;justify-content:center;font-family:"Plus Jakarta Sans",sans-serif;font-size:14px;font-weight:700;line-height:1;color:#0a0a0a;background:#fff;border:1.5px solid #d8e2f0;border-radius:10px;cursor:pointer;transition:border-color .15s,color .15s;}
.bl-pg:hover{border-color:#0078D4;color:#0078D4;}
.bl-pg[aria-current="page"]{background:#0078D4;border-color:#0078D4;color:#fff;}
.bl-pg[disabled]{opacity:.4;cursor:default;pointer-events:none;}
</style>

<!-- HERO -->
<div class="blog-hero">
  <div class="blog-hero-inner">
    <div class="blog-eyebrow">Blog</div>
    <h1>Practical advice on documentation, <em>from people who write it.</em></h1>
    <p>Guides, how-tos and industry notes on technical writing, style guides, API documentation, working with writers and making content ready for AI.</p>
  </div>
</div>


<!-- SEARCH AND TOPIC -->
<div class="bl-tools">
  <div class="bl-tools-inner">
    <label class="bl-search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
      <input type="search" id="blSearch" placeholder="Search articles" aria-label="Search articles" autocomplete="off" />
    </label>
    <label class="bl-select">
      <span>Topic</span>
      <select id="blTopic" aria-label="Filter by topic">
        <option value="all">All topics</option>
        {categories.map((c) => (<option value={c.key}>{c.label}</option>))}
      </select>
    </label>
  </div>
  <div class="bl-status" aria-live="polite">
    <span id="blCount"></span>
    <button type="button" class="bl-clear" id="blClear" hidden>Clear filters</button>
  </div>
</div>

<!-- ARTICLES -->
<div class="bl-body">
  <div class="bl-inner">
    <div class="bl-list" id="blList">
      {posts.map((p) => (
        <article class="bl-item" data-category={p.category} data-text={`${p.title} ${p.summary} ${p.categoryLabel}`.toLowerCase()}>
          <a class="bl-thumb" href={`/blog/${p.slug}`} tabindex="-1" aria-hidden="true" style={`background:${p.bannerBg};`}>
            {p.photo ? (<img src={p.photo} alt="" loading="lazy" style={p.photoFit === 'contain' ? 'object-fit:contain;padding:16px;box-sizing:border-box;' : ''} />) : (<span class="bl-thumb-word">{p.bannerWord}</span>)}
          </a>
          <div class="bl-main">
            <div class="bl-cats"><button type="button" class="bl-cat" data-topic={p.category}>{p.categoryLabel}</button></div>
            <h2><a href={`/blog/${p.slug}`}>{p.title}</a></h2>
            <p>{p.summary}</p>
            <div class="bl-meta">{p.date} &middot; {p.readTime} read</div>
          </div>
        </article>
      ))}
    </div>
    <div class="bl-empty" id="blEmpty" hidden>No articles match your search. Try a different word or clear the filters.</div>
    <nav class="bl-pager" id="blPager" aria-label="Pages" hidden></nav>
  </div>
</div>

<!-- CTA + WAVES -->
<div class="bottom">
  <div class="wrap">
    <div class="cta">
      <div class="cta-eyebrow">Questions?</div>
      <h2 class="cta-h2">Have a documentation problem to <em>solve?</em></h2>
      <p class="cta-sub">Tell us what you are working on. We will tell you how we would approach it.</p>
      <div class="cta-btns">
        <button class="btn-lift" style="all:unset;box-sizing:border-box;transition:transform .22s cubic-bezier(.34,1.1,.64,1),box-shadow .22s;display:inline-flex;align-items:center;gap:8px;background-color:#0a0a0a;color:#fff;padding:13px 28px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;" onclick="location.href='/contact'">Get in touch <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button>
        <button class="btn-lift" style="all:unset;box-sizing:border-box;transition:transform .22s cubic-bezier(.34,1.1,.64,1),box-shadow .22s;display:inline-flex;align-items:center;gap:8px;background-color:#fff;color:#0a0a0a;border:1.5px solid #d0d0d0;padding:12px 24px;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;" onclick="location.href='/work/case-studies'">View our work <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0a0a0a" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button>
      </div>
    </div>
  </div>
  <canvas id="waveCanvas"></canvas>
</div>


<script is:inline define:vars={{ perPage: PER_PAGE }}>
(function(){
  var items=[].slice.call(document.querySelectorAll('.bl-item'));
  var search=document.getElementById('blSearch'),topic=document.getElementById('blTopic');
  var count=document.getElementById('blCount'),clear=document.getElementById('blClear');
  var empty=document.getElementById('blEmpty'),pager=document.getElementById('blPager');
  var page=1;
  var params=new URLSearchParams(location.search);
  if(params.get('q')) search.value=params.get('q');
  if(params.get('topic')) topic.value=params.get('topic');
  if(topic.value!==params.get('topic') && params.get('topic')) topic.value='all';
  page=parseInt(params.get('page')||'1',10)||1;

  function sync(){
    var u=new URLSearchParams();
    if(search.value.trim()) u.set('q',search.value.trim());
    if(topic.value!=='all') u.set('topic',topic.value);
    if(page>1) u.set('page',String(page));
    var s=u.toString();
    try{history.replaceState(null,'',location.pathname+(s?'?'+s:''));}catch(e){}
  }
  function render(){
    var q=search.value.trim().toLowerCase(), t=topic.value;
    var words=q?q.split(/\s+/):[];
    var match=items.filter(function(el){
      if(t!=='all' && el.dataset.category!==t) return false;
      return words.every(function(w){return el.dataset.text.indexOf(w)>-1;});
    });
    var pages=Math.max(1,Math.ceil(match.length/perPage));
    if(page>pages) page=pages;
    var start=(page-1)*perPage;
    items.forEach(function(el){el.hidden=true;});
    match.slice(start,start+perPage).forEach(function(el){el.hidden=false;});
    var filtered=!!q||t!=='all';
    count.textContent=match.length===items.length&&!filtered?items.length+' articles':match.length+' of '+items.length+' articles';
    clear.hidden=!filtered;
    empty.hidden=match.length>0;
    pager.hidden=pages<=1;
    pager.innerHTML='';
    if(pages>1){
      var mk=function(label,p,cur,dis){var b=document.createElement('button');b.type='button';b.className='bl-pg';b.textContent=label;if(cur)b.setAttribute('aria-current','page');if(dis)b.disabled=true;b.addEventListener('click',function(){page=p;render();window.scrollTo({top:document.querySelector('.bl-tools').offsetTop-20,behavior:'smooth'});});pager.appendChild(b);};
      mk('Previous',page-1,false,page===1);
      for(var i=1;i<=pages;i++) mk(String(i),i,i===page,false);
      mk('Next',page+1,false,page===pages);
    }
    sync();
  }
  search.addEventListener('input',function(){page=1;render();});
  topic.addEventListener('change',function(){page=1;render();});
  clear.addEventListener('click',function(){search.value='';topic.value='all';page=1;render();});
  document.querySelectorAll('.bl-cat').forEach(function(b){b.addEventListener('click',function(){topic.value=b.dataset.topic;page=1;render();window.scrollTo({top:document.querySelector('.bl-tools').offsetTop-20,behavior:'smooth'});});});
  render();
})();
</script>
<script>
const wc=document.getElementById('waveCanvas');
const wx=wc&&wc.getContext('2d');
function resize(){if(!wc)return;wc.width=wc.offsetWidth;wc.height=200;}
resize();window.addEventListener('resize',resize);
const layers=[
  {a:20,s:.0009,c1:'#b8d0e8',c2:'#88b0d0',y:0.44,o:.5,p:0},
  {a:18,s:.0007,c1:'#4888c0',c2:'#0078D4',y:0.54,o:.62,p:1.8},
  {a:18,s:.0011,c1:'#0060a8',c2:'#004880',y:0.65,o:.72,p:3.2},
  {a:16,s:.0006,c1:'#003060',c2:'#002040',y:0.75,o:.82,p:0.9},
  {a:14,s:.0013,c1:'#011828',c2:'#021430',y:0.85,o:.93,p:2.1},
  {a:10,s:.0005,c1:'#010e20',c2:'#010e20',y:0.93,o:1,p:1.2},
];
function draw(t){
  if(!wx||!wc)return;
  const W=wc.width,H=wc.height;
  wx.clearRect(0,0,W,H);
  wx.fillStyle='#f8f9fa';wx.fillRect(0,0,W,H);
  layers.forEach(l=>{
    wx.beginPath();
    const by=H*l.y;wx.moveTo(0,H);
    for(let x=0;x<=W;x+=2){
      const n=x/W;
      const raw=by+Math.sin(n*Math.PI*3.5+t*l.s+l.p)*l.a+Math.sin(n*Math.PI*6+t*l.s*.65+l.p*1.4)*l.a*.35;
      wx.lineTo(x,Math.max(by-l.a*1.45,raw));
    }
    wx.lineTo(W,H);wx.closePath();
    const g=wx.createLinearGradient(0,0,W,0);
    g.addColorStop(0,l.c1);g.addColorStop(1,l.c2);
    wx.fillStyle=g;wx.globalAlpha=l.o;wx.fill();
  });
  wx.globalAlpha=1;requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>

</BaseLayout>
