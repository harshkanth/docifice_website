---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Technical Recruitment" description="Hire the right technical writer. Docifice sources, assesses and introduces documentation talent for your in-house team.">

<style>
.td-hero{background:#021430;padding:72px 0 64px;position:relative;overflow:hidden;}
.td-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 70% 20%,rgba(0,120,212,.28) 0%,transparent 60%);pointer-events:none;}
.td-hero-inner{max-width:1400px;margin:0 auto;padding:0 32px;position:relative;z-index:2;display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center;}
.td-eyebrow{font-size:11px;font-weight:700;letter-spacing:.04em;color:#7dd3fc;margin-bottom:14px;}
.td-hero h1{font-size:52px;font-weight:800;color:#fff;letter-spacing:-.04em;line-height:1.04;margin-bottom:18px;}
.td-hero h1 em{font-style:normal;color:#7dd3fc;}
.td-hero p{font-size:16px;color:rgba(255,255,255,.58);line-height:1.76;max-width:480px;margin-bottom:32px;}
.td-hero-btns{display:flex;gap:12px;align-items:center;}
.trust-bar{background:#f8f9fa;border-bottom:1px solid #f0f0f0;padding:20px 0;}
.trust-bar-inner{max-width:1400px;margin:0 auto;padding:0 32px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;}
.trust-label{font-size:13px;font-weight:700;color:#0a0a0a;white-space:nowrap;}
.trust-items{display:flex;flex:1;justify-content:space-between;flex-wrap:wrap;align-items:center;margin-left:32px;}
.trust-item{font-size:13px;font-weight:600;color:#555;display:flex;align-items:center;gap:6px;}
.section{padding:88px 0;}
.section-alt{background:#f8f9fa;}
.wrap{max-width:1400px;margin:0 auto;padding:0 32px;}
.section-ey{font-size:11px;font-weight:700;letter-spacing:.04em;color:#0078D4;margin-bottom:12px;}
.section-h2{font-size:36px;font-weight:800;letter-spacing:-.04em;color:#0a0a0a;line-height:1.1;margin-bottom:14px;}
.section-sub{font-size:15px;color:#666;line-height:1.6;}
.del-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:40px;}
.del-cat{border-radius:12px;padding:24px 26px;border:1.5px solid #d8e2f0;border-top:3px solid #d8e2f0;background:#fff;transition:border-color .2s,box-shadow .2s,transform .22s cubic-bezier(.34,1.1,.64,1);}
.del-cat:hover{border-color:#c8ddf5;border-top-color:#0078D4;box-shadow:0 6px 20px rgba(0,120,212,.08);transform:translateY(-3px);}
.del-cat-icon{font-size:10px;font-weight:700;letter-spacing:.05em;color:#0078D4;margin-bottom:6px;display:block;}
.del-cat-title{font-size:15px;font-weight:800;color:#0a0a0a;letter-spacing:-.02em;margin-bottom:12px;}
.del-cat-list{list-style:none;display:flex;flex-direction:column;gap:6px;}
.del-cat-list li{font-size:12px;color:#444;padding-left:14px;position:relative;line-height:1.5;}
.del-cat-list li::before{content:'';position:absolute;left:0;top:6px;width:5px;height:5px;border-radius:50%;background:#0078D4;}
.aud-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:40px;}
.aud-card{background:#fff;border:1px solid #eaecf0;border-radius:10px;padding:18px 20px;display:flex;align-items:center;gap:12px;transition:border-color .2s,box-shadow .2s,transform .22s cubic-bezier(.34,1.1,.64,1);}
.aud-card:hover{border-color:#0078D4;box-shadow:0 4px 16px rgba(0,120,212,.08);transform:translateY(-2px);}
.aud-icon{width:32px;height:32px;border-radius:8px;background:#f0f5ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.aud-name{font-size:13px;font-weight:600;color:#0a0a0a;}
.process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:40px;}
.process-step{background:#fff;border:1px solid #e4edf8;border-radius:12px;padding:28px 24px;}
.process-num{font-size:11px;font-weight:700;color:#0078D4;letter-spacing:.04em;margin-bottom:12px;}
.process-title{font-size:16px;font-weight:800;color:#0a0a0a;margin-bottom:8px;letter-spacing:-.02em;}
.process-desc{font-size:13px;color:#666;line-height:1.65;}
.tools-grid{display:flex;flex-wrap:wrap;gap:10px;margin-top:32px;}
.tool-tag{font-size:12px;font-weight:600;padding:7px 14px;border-radius:8px;background:rgba(255,255,255,.07);color:rgba(255,255,255,.8);border:1px solid rgba(255,255,255,.1);transition:background .2s,color .2s,border-color .2s;}
.tool-tag:hover{background:rgba(0,120,212,.2);border-color:rgba(0,120,212,.4);color:#fff;}
.faq-list{display:flex;flex-direction:column;gap:2px;margin-top:48px;}
.faq-item{border:1px solid #eaecf0;border-radius:10px;overflow:hidden;}
.faq-q{padding:20px 24px;font-size:15px;font-weight:600;color:#0a0a0a;cursor:pointer;display:flex;justify-content:space-between;align-items:center;user-select:none;}
.faq-q:hover{background:#f8f9fa;}
.faq-a{padding:0 24px 0;font-size:14px;color:#555;line-height:1.74;max-height:0;overflow:hidden;transition:max-height .35s ease,padding .35s ease;}
.faq-item.open .faq-a{max-height:200px;padding:0 24px 20px;}
.faq-item.open .faq-chevron{transform:rotate(180deg);}
.faq-chevron{transition:transform .2s;flex-shrink:0;color:#0078D4;}
.btn-primary{all:unset;box-sizing:border-box;display:inline-flex;align-items:center;gap:8px;background:#0078D4;color:#fff;padding:13px 28px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;transition:transform .22s cubic-bezier(.34,1.1,.64,1),box-shadow .22s,opacity .2s;text-decoration:none;}
.btn-primary:hover{opacity:.88;transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,120,212,.3);}
.btn-ghost{all:unset;box-sizing:border-box;display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);color:#fff;border:1.5px solid rgba(255,255,255,.3);padding:12px 24px;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;transition:background .2s,transform .22s cubic-bezier(.34,1.1,.64,1);text-decoration:none;}
.btn-ghost:hover{background:rgba(255,255,255,.2);transform:translateY(-2px);}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}

.mv-card{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 32px 80px rgba(0,0,0,.45);border:1px solid rgba(255,255,255,.15);}
.mv-bar{background:#f7f8fa;padding:9px 16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ebebeb;font-size:11px;color:#888;}
.mv-body{padding:14px 16px;display:flex;flex-direction:column;gap:7px;}
.mv-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border:1px solid #eef0f3;border-radius:8px;font-size:12px;font-weight:600;color:#0a0a0a;}
.mv-row small{display:block;font-size:10px;font-weight:500;color:#888;margin-top:2px;}
.pill{font-size:9px;font-weight:700;padding:3px 9px;border-radius:4px;white-space:nowrap;}
.s-d{background:#e7f8ee;color:#16a34a;}
.s-p{background:#e8f2ff;color:#0078D4;}
.s-s{background:#f1f3f5;color:#777;}
.cta-dark,.cta-light{box-sizing:border-box;display:inline-flex;align-items:center;gap:8px;padding:13px 28px;border-radius:8px;font-size:14px;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;text-decoration:none;transition:transform .22s cubic-bezier(.34,1.1,.64,1),box-shadow .22s;}
.cta-dark{background:#0a0a0a;color:#fff;}
.cta-light{background:#fff;color:#0a0a0a;border:1.5px solid #d0d0d0;font-weight:500;padding:12px 24px;}
.cta-dark:hover,.cta-light:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.15);}
.faq-item.open .faq-a{max-height:260px;}
.cmp{display:grid;grid-template-columns:1fr 1.5fr 1.5fr;margin-top:40px;border:1.5px solid #d8e2f0;border-radius:12px;overflow:hidden;background:#fff;}
.cmp>div,.cmp>a{padding:18px 22px;border-top:1px solid #eef1f6;font-size:14px;color:#333;line-height:1.5;}
.cmp>.cmp-h{border-top:none;font-size:15px;font-weight:800;color:#0a0a0a;background:#f0f5ff;text-decoration:none;letter-spacing:-.02em;}
.cmp-link:hover{color:#0078D4;}
.cmp-l{font-size:11px!important;font-weight:700;letter-spacing:.04em;color:#0078D4!important;}
@media(max-width:700px){.cmp{grid-template-columns:1fr}.cmp>.cmp-h:first-child{display:none}.cmp-c::before{content:attr(data-l) ': ';font-weight:700;color:#0a0a0a;}.cmp>div,.cmp>a{padding:12px 18px}}
@media(max-width:900px){.td-hero-inner{grid-template-columns:1fr;gap:36px}.td-hero h1{font-size:36px}.del-grid,.aud-grid,.process-grid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.del-grid,.aud-grid,.process-grid{grid-template-columns:1fr}.td-hero-btns{flex-wrap:wrap}}
</style>

<!-- HERO -->
<div class="td-hero">
  <div class="td-hero-inner">
    <div>
      <div class="td-eyebrow">Technical Recruitment</div>
      <h1>Find the technical writer <em>you need to hire.</em></h1>
      <p>Building your own documentation team? We find and assess technical writers, then introduce you to the candidates worth your time, so you hire with confidence.</p>
      <div class="td-hero-btns">
        <a href="/contact" class="btn-primary">Get in touch <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/work/case-studies" class="btn-ghost">View case studies <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
      </div>
    </div>
    <div class="mv-card">
      <div class="mv-bar"><span>Hiring pipeline &middot; Senior Technical Writer</span><span class="pill s-p">Recruitment</span></div>
      <div class="mv-body">
        <div class="mv-row"><div>Role intake<small>Skills and context agreed</small></div><span class="pill s-d">Delivered</span></div>
        <div class="mv-row"><div>Candidate sourcing<small>Documentation specialists</small></div><span class="pill s-p">Sourcing</span></div>
        <div class="mv-row"><div>Writing assessment<small>Practical sample reviewed</small></div><span class="pill s-p">Interviewing</span></div>
        <div class="mv-row"><div>Shortlist introduced<small>Ready for your interviews</small></div><span class="pill s-d">Shortlisted</span></div>
      </div>
    </div>
  </div>
</div>

<div class="section" id="included">
  <div class="wrap">
    <div class="section-ey">What's Included</div>
    <div class="section-h2">Hiring for documentation, by people who do documentation.</div>
    <div class="section-sub">We understand the craft, so we can tell a strong writer from a strong CV.</div>
    <div class="del-grid">
      <div class="del-cat" id="sourcing">
        <span class="del-cat-icon">Sourcing</span>
        <div class="del-cat-title">Reaching the right people</div>
        <ul class="del-cat-list">
          <li>Documentation and API writers</li>
          <li>Docs-as-code specialists</li>
          <li>Content strategists and leads</li>
          <li>Documentation engineers</li>
          <li>Writers for specialised domains</li>
        </ul>
      </div>
      <div class="del-cat" id="assessment">
        <span class="del-cat-icon">Assessment</span>
        <div class="del-cat-title">Judging real ability</div>
        <ul class="del-cat-list">
          <li>Review of writing samples</li>
          <li>Practical writing exercise</li>
          <li>Technical depth check</li>
          <li>Communication and collaboration</li>
          <li>Tool and workflow fit</li>
        </ul>
      </div>
      <div class="del-cat" id="placement">
        <span class="del-cat-icon">Placement</span>
        <div class="del-cat-title">From shortlist to hire</div>
        <ul class="del-cat-list">
          <li>Role definition support</li>
          <li>Curated shortlist of candidates</li>
          <li>Introductions and interview support</li>
          <li>Offer stage guidance</li>
          <li>One-time placement fee</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<div class="section section-alt">
  <div class="wrap">
    <div class="section-ey">Who It's For</div>
    <div class="section-h2">For teams ready to hire a writer of their own.</div>
    <div class="section-sub">If you want a permanent member of your team, we help you find the right person faster.</div>
    <div class="aud-grid">
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">Startups making a first writer hire</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">Scaling product teams</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">Engineering leaders</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">Documentation managers</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">Platform companies</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">API-first businesses</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">Enterprise teams</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">Hiring managers</span></div>
    </div>
  </div>
</div>

<div class="section" style="background:#f0f5ff;">
  <div class="wrap">
    <div class="section-ey">How It Works</div>
    <div class="section-h2">How recruitment works.</div>
    <div class="section-sub">We start by understanding the role and what your team needs.</div>
    <div class="process-grid">
      <div class="process-step">
        <div class="process-num">01 / Intake</div>
        <div class="process-title">Understand the role</div>
        <div class="process-desc">We learn about your product, team and the skills that matter, and agree what a strong hire looks like for you.</div>
      </div>
      <div class="process-step">
        <div class="process-num">02 / Source</div>
        <div class="process-title">Find candidates</div>
        <div class="process-desc">We reach into our network and beyond to find documentation talent that fits the brief.</div>
      </div>
      <div class="process-step">
        <div class="process-num">03 / Assess</div>
        <div class="process-title">Check real ability</div>
        <div class="process-desc">We review writing, test practical skills and confirm technical and communication strengths.</div>
      </div>
      <div class="process-step">
        <div class="process-num">04 / Introduce</div>
        <div class="process-title">Meet the shortlist</div>
        <div class="process-desc">You meet a curated shortlist and run your own interviews, with our support through to offer.</div>
      </div>
    </div>
  </div>
</div>

<div class="section">
  <div class="wrap">
    <div class="section-ey">FAQs</div>
    <div class="section-h2">Common questions.</div>
    <div class="faq-list">
      <div class="faq-item">
        <div class="faq-q">How is recruitment priced? <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
        <div class="faq-a">We charge a one-time placement fee when you hire a candidate we introduced. Get in touch and we will share the details for your role.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">What kinds of roles do you recruit for? <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
        <div class="faq-a">Technical writers, API documentation specialists, documentation engineers, content strategists and documentation leads.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">How do you assess candidates? <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
        <div class="faq-a">We review writing samples, set a practical exercise where appropriate, and check technical depth and collaboration.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">Can you recruit for a hard-to-fill niche? <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
        <div class="faq-a">Often, yes. Tell us the domain and tools, and we will say honestly whether we can help.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">Do I interview the candidates myself? <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
        <div class="faq-a">Yes. We introduce a curated shortlist and you make the hiring decision.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">What if I would rather not hire permanently? <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
        <div class="faq-a">See Embedded Writers, where a writer joins your team for as long as you need.</div>
      </div>
    </div>
  </div>
</div>

<!-- CTA + WAVES -->
<div class="bottom">
  <div class="wrap">
    <div class="cta">
      <div class="cta-eyebrow">Ready when you are</div>
      <h2 class="cta-h2">Tell us who you are looking <em>to hire.</em></h2>
      <p class="cta-sub">Share the role and we will tell you how we can help you fill it.</p>
      <div class="cta-btns">
        <a href="/contact" class="cta-dark">Get in touch <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/ways-to-engage/embedded-writers" class="cta-light">Explore embedded writers <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0a0a0a" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
      </div>
    </div>
  </div>
  <canvas id="waveCanvas"></canvas>
</div>

<script>
document.querySelectorAll('.faq-q').forEach(q => {
  q.addEventListener('click', () => {
    const item = q.parentElement;
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
    if (!isOpen) item.classList.add('open');
  });
});
const wc=document.getElementById('waveCanvas');
const wx=wc&&wc.getContext('2d');
function resize(){if(!wc)return;wc.width=wc.offsetWidth;wc.height=200;}
resize();window.addEventListener('resize',resize);
const layers=[
  {a:20,s:.0009,c1:'#b8d0e8',c2:'#88b0d0',y:0.44,o:.5,p:0},
  {a:18,s:.0007,c1:'#4888c0',c2:'#0078D4',y:0.54,o:.62,p:1.8},
  {a:18,s:.0011,c1:'#0060a8',c2:'#004880',y:0.65,o:.72,p:3.2},
  {a:16,s:.0006,c1:'#003060',c2:'#002040',y:0.75,o:.82,p:0.9},
  {a:14,s:.0013,c1:'#011828',c2:'#021430',y:0.85,o:.93,p:2.1},
  {a:10,s:.0005,c1:'#010e20',c2:'#010e20',y:0.93,o:1,p:1.2},
];
function draw(t){
  if(!wx||!wc)return;
  const W=wc.width,H=wc.height;
  wx.clearRect(0,0,W,H);
  wx.fillStyle='#f8f9fa';wx.fillRect(0,0,W,H);
  layers.forEach(l=>{
    wx.beginPath();
    const by=H*l.y;wx.moveTo(0,H);
    for(let x=0;x<=W;x+=2){
      const n=x/W;
      const raw=by+Math.sin(n*Math.PI*3.5+t*l.s+l.p)*l.a+Math.sin(n*Math.PI*6+t*l.s*.65+l.p*1.4)*l.a*.35;
      wx.lineTo(x,Math.max(by-l.a*1.45,raw));
    }
    wx.lineTo(W,H);wx.closePath();
    const g=wx.createLinearGradient(0,0,W,0);
    g.addColorStop(0,l.c1);g.addColorStop(1,l.c2);
    wx.fillStyle=g;wx.globalAlpha=l.o;wx.fill();
  });
  wx.globalAlpha=1;requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>

</BaseLayout>
