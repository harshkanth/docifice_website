---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="End-to-End Documentation" description="End-to-end documentation from Docifice: a team that plans, writes, reviews and maintains your documentation, working alongside your team every day.">

<style>
.td-hero{background:#021430;padding:72px 0 64px;position:relative;overflow:hidden;}
.td-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 70% 20%,rgba(0,120,212,.28) 0%,transparent 60%);pointer-events:none;}
.td-hero-inner{max-width:1400px;margin:0 auto;padding:0 32px;position:relative;z-index:2;display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center;}
.td-eyebrow{font-size:11px;font-weight:700;letter-spacing:.04em;color:#7dd3fc;margin-bottom:14px;}
.td-hero h1{font-size:52px;font-weight:800;color:#fff;letter-spacing:-.04em;line-height:1.04;margin-bottom:18px;}
.td-hero h1 em{font-style:normal;color:#7dd3fc;}
.td-hero p{font-size:16px;color:rgba(255,255,255,.58);line-height:1.76;max-width:480px;margin-bottom:32px;}
.td-hero-btns{display:flex;gap:12px;align-items:center;}
.trust-bar{background:#f8f9fa;border-bottom:1px solid #f0f0f0;padding:20px 0;}
.trust-bar-inner{max-width:1400px;margin:0 auto;padding:0 32px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;}
.trust-label{font-size:13px;font-weight:700;color:#0a0a0a;white-space:nowrap;}
.trust-items{display:flex;flex:1;justify-content:space-between;flex-wrap:wrap;align-items:center;margin-left:32px;}
.trust-item{font-size:13px;font-weight:600;color:#555;display:flex;align-items:center;gap:6px;}
.section{padding:88px 0;}
.section-alt{background:#f8f9fa;}
.wrap{max-width:1400px;margin:0 auto;padding:0 32px;}
.section-ey{font-size:11px;font-weight:700;letter-spacing:.04em;color:#0078D4;margin-bottom:12px;}
.section-h2{font-size:36px;font-weight:800;letter-spacing:-.04em;color:#0a0a0a;line-height:1.1;margin-bottom:14px;}
.section-sub{font-size:15px;color:#666;line-height:1.6;}
.del-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:40px;}
.del-cat{border-radius:12px;padding:24px 26px;border:1.5px solid #d8e2f0;border-top:3px solid #d8e2f0;background:#fff;transition:border-color .2s,box-shadow .2s,transform .22s cubic-bezier(.34,1.1,.64,1);}
.del-cat:hover{border-color:#c8ddf5;border-top-color:#0078D4;box-shadow:0 6px 20px rgba(0,120,212,.08);transform:translateY(-3px);}
.del-cat-icon{font-size:10px;font-weight:700;letter-spacing:.05em;color:#0078D4;margin-bottom:6px;display:block;}
.del-cat-title{font-size:15px;font-weight:800;color:#0a0a0a;letter-spacing:-.02em;margin-bottom:12px;}
.del-cat-list{list-style:none;display:flex;flex-direction:column;gap:6px;}
.del-cat-list li{font-size:12px;color:#444;padding-left:14px;position:relative;line-height:1.5;}
.del-cat-list li::before{content:'';position:absolute;left:0;top:6px;width:5px;height:5px;border-radius:50%;background:#0078D4;}
.aud-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:40px;}
.aud-card{background:#fff;border:1px solid #eaecf0;border-radius:10px;padding:18px 20px;display:flex;align-items:center;gap:12px;transition:border-color .2s,box-shadow .2s,transform .22s cubic-bezier(.34,1.1,.64,1);}
.aud-card:hover{border-color:#0078D4;box-shadow:0 4px 16px rgba(0,120,212,.08);transform:translateY(-2px);}
.aud-icon{width:32px;height:32px;border-radius:8px;background:#f0f5ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.aud-name{font-size:13px;font-weight:600;color:#0a0a0a;}
.process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:40px;}
.process-step{background:#fff;border:1px solid #e4edf8;border-radius:12px;padding:28px 24px;}
.process-num{font-size:11px;font-weight:700;color:#0078D4;letter-spacing:.04em;margin-bottom:12px;}
.process-title{font-size:16px;font-weight:800;color:#0a0a0a;margin-bottom:8px;letter-spacing:-.02em;}
.process-desc{font-size:13px;color:#666;line-height:1.65;}
.tools-grid{display:flex;flex-wrap:wrap;gap:10px;margin-top:32px;}
.tool-tag{font-size:12px;font-weight:600;padding:7px 14px;border-radius:8px;background:rgba(255,255,255,.07);color:rgba(255,255,255,.8);border:1px solid rgba(255,255,255,.1);transition:background .2s,color .2s,border-color .2s;}
.tool-tag:hover{background:rgba(0,120,212,.2);border-color:rgba(0,120,212,.4);color:#fff;}
.faq-list{display:flex;flex-direction:column;gap:2px;margin-top:48px;}
.faq-item{border:1px solid #eaecf0;border-radius:10px;overflow:hidden;}
.faq-q{padding:20px 24px;font-size:15px;font-weight:600;color:#0a0a0a;cursor:pointer;display:flex;justify-content:space-between;align-items:center;user-select:none;}
.faq-q:hover{background:#f8f9fa;}
.faq-a{padding:0 24px 0;font-size:14px;color:#555;line-height:1.74;max-height:0;overflow:hidden;transition:max-height .35s ease,padding .35s ease;}
.faq-item.open .faq-a{max-height:200px;padding:0 24px 20px;}
.faq-item.open .faq-chevron{transform:rotate(180deg);}
.faq-chevron{transition:transform .2s;flex-shrink:0;color:#0078D4;}
.btn-primary{all:unset;box-sizing:border-box;display:inline-flex;align-items:center;gap:8px;background:#0078D4;color:#fff;padding:13px 28px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;transition:transform .22s cubic-bezier(.34,1.1,.64,1),box-shadow .22s,opacity .2s;text-decoration:none;}
.btn-primary:hover{opacity:.88;transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,120,212,.3);}
.btn-ghost{all:unset;box-sizing:border-box;display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);color:#fff;border:1.5px solid rgba(255,255,255,.3);padding:12px 24px;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;transition:background .2s,transform .22s cubic-bezier(.34,1.1,.64,1);text-decoration:none;}
.btn-ghost:hover{background:rgba(255,255,255,.2);transform:translateY(-2px);}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}

.mv-card{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 32px 80px rgba(0,0,0,.45);border:1px solid rgba(255,255,255,.15);}
.mv-bar{background:#f7f8fa;padding:9px 16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ebebeb;font-size:11px;color:#888;}
.mv-body{padding:14px 16px;display:flex;flex-direction:column;gap:7px;}
.mv-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border:1px solid #eef0f3;border-radius:8px;font-size:12px;font-weight:600;color:#0a0a0a;}
.mv-row small{display:block;font-size:10px;font-weight:500;color:#888;margin-top:2px;}
.pill{font-size:9px;font-weight:700;padding:3px 9px;border-radius:4px;white-space:nowrap;}
.s-d{background:#e7f8ee;color:#16a34a;}
.s-p{background:#e8f2ff;color:#0078D4;}
.s-s{background:#f1f3f5;color:#777;}
.cta-dark,.cta-light{box-sizing:border-box;display:inline-flex;align-items:center;gap:8px;padding:13px 28px;border-radius:8px;font-size:14px;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;line-height:1;text-decoration:none;transition:transform .22s cubic-bezier(.34,1.1,.64,1),box-shadow .22s;}
.cta-dark{background:#0a0a0a;color:#fff;}
.cta-light{background:#fff;color:#0a0a0a;border:1.5px solid #d0d0d0;font-weight:500;padding:12px 24px;}
.cta-dark:hover,.cta-light:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.15);}
.faq-item.open .faq-a{max-height:260px;}
.cmp{display:grid;grid-template-columns:1fr 1.5fr 1.5fr;margin-top:40px;border:1.5px solid #d8e2f0;border-radius:12px;overflow:hidden;background:#fff;}
.cmp>div,.cmp>a{padding:18px 22px;border-top:1px solid #eef1f6;font-size:14px;color:#333;line-height:1.5;}
.cmp>.cmp-h{border-top:none;font-size:15px;font-weight:800;color:#0a0a0a;background:#f0f5ff;text-decoration:none;letter-spacing:-.02em;}
.cmp-link:hover{color:#0078D4;}
.cmp-l{font-size:11px!important;font-weight:700;letter-spacing:.04em;color:#0078D4!important;}
@media(max-width:700px){.cmp{grid-template-columns:1fr}.cmp>.cmp-h:first-child{display:none}.cmp-c::before{content:attr(data-l) ': ';font-weight:700;color:#0a0a0a;}.cmp>div,.cmp>a{padding:12px 18px}}
@media(max-width:900px){.td-hero-inner{grid-template-columns:1fr;gap:36px}.td-hero h1{font-size:36px}.del-grid,.aud-grid,.process-grid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.del-grid,.aud-grid,.process-grid{grid-template-columns:1fr}.td-hero-btns{flex-wrap:wrap}}
</style>

<!-- HERO -->
<div class="td-hero">
  <div class="td-hero-inner">
    <div>
      <div class="td-eyebrow">End-to-End Documentation</div>
      <h1>A documentation team that runs itself, <em>in step with yours.</em></h1>
      <p>We take ownership of your documentation and work alongside your team every day, in your tools, your check-ins and your review cycles. You stay close to it without having to run it. It can be one writer or a dedicated team, scaled to the work.</p>
      <div class="td-hero-btns">
        <a href="/contact" class="btn-primary">Get in touch <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/work/case-studies" class="btn-ghost">View case studies <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
      </div>
    </div>
    <div class="mv-card">
      <div class="mv-bar"><span>Documentation programme &middot; Release 4.2</span><span class="pill s-p">End-to-end</span></div>
      <div class="mv-body">
        <div class="mv-row"><div>API reference<small>Reviewed with engineering</small></div><span class="pill s-d">Delivered</span></div>
        <div class="mv-row"><div>Admin guide<small>Draft with product team</small></div><span class="pill s-p">In progress</span></div>
        <div class="mv-row"><div>Release notes<small>Ready for next release</small></div><span class="pill s-s">Scheduled</span></div>
        <div class="mv-row"><div>Knowledge base<small>Restructure and migration</small></div><span class="pill s-p">In progress</span></div>
      </div>
    </div>
  </div>
</div>

<div class="section" id="included">
  <div class="wrap">
    <div class="section-ey">What's Included</div>
    <div class="section-h2">One partner for the whole documentation workload.</div>
    <div class="section-sub">We own the documentation your product needs, across audiences and formats, and run it day to day with your team.</div>
    <div class="del-grid">
      <div class="del-cat" id="developer">
        <span class="del-cat-icon">Developer Documentation</span>
        <div class="del-cat-title">For the people building on your product</div>
        <ul class="del-cat-list">
          <li>API reference and guides</li>
          <li>SDK and integration docs</li>
          <li>Quickstarts and tutorials</li>
          <li>Code samples and changelogs</li>
          <li>Docs-as-code setup</li>
        </ul>
      </div>
      <div class="del-cat" id="user">
        <span class="del-cat-icon">User Documentation</span>
        <div class="del-cat-title">For the people using your product</div>
        <ul class="del-cat-list">
          <li>User and admin guides</li>
          <li>Knowledge base articles</li>
          <li>Release notes</li>
          <li>Onboarding and how-to content</li>
          <li>In-app help content</li>
        </ul>
      </div>
      <div class="del-cat" id="internal">
        <span class="del-cat-icon">Internal Documentation</span>
        <div class="del-cat-title">For the people running your business</div>
        <ul class="del-cat-list">
          <li>Process and SOP documentation</li>
          <li>Runbooks and playbooks</li>
          <li>Internal knowledge bases</li>
          <li>Policy and compliance content</li>
          <li>Style guides and templates</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<div class="section section-alt">
  <div class="wrap">
    <div class="section-ey">Who It's For</div>
    <div class="section-h2">Built for teams that need documentation, not another project.</div>
    <div class="section-sub">If documentation keeps slipping down the priority list, end-to-end documentation gives it an owner.</div>
    <div class="aud-grid">
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">Product companies</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">SaaS startups</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">API-first businesses</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">Engineering teams</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">Platform teams</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">Support organisations</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">Compliance teams</span></div>
      <div class="aud-card"><div class="aud-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0078D4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><span class="aud-name">Operations teams</span></div>
    </div>
  </div>
</div>

<div class="section" style="background:#f0f5ff;">
  <div class="wrap">
    <div class="section-ey">How It Works</div>
    <div class="section-h2">A daily rhythm, not a hand-off.</div>
    <div class="section-sub">You get a clear plan, a steady cadence, and a team that is part of your working week.</div>
    <div class="process-grid">
      <div class="process-step">
        <div class="process-num">01 / Scope</div>
        <div class="process-title">Define what is needed</div>
        <div class="process-desc">We review your product, audiences and existing content, then agree what gets documented and in what order.</div>
      </div>
      <div class="process-step">
        <div class="process-num">02 / Plan</div>
        <div class="process-title">Set the roadmap</div>
        <div class="process-desc">We turn the scope into a delivery plan with priorities, owners and review points that fit your release cycle.</div>
      </div>
      <div class="process-step">
        <div class="process-num">03 / Collaborate</div>
        <div class="process-title">Work alongside your team</div>
        <div class="process-desc">We join your channels and check-ins, write with your subject matter experts, and publish into the tools your team already uses.</div>
      </div>
      <div class="process-step">
        <div class="process-num">04 / Improve</div>
        <div class="process-title">Keep it current</div>
        <div class="process-desc">We keep documentation moving with each release, report on progress, and hand over source files whenever you want them.</div>
      </div>
    </div>
  </div>
</div>

<div class="section section-alt">
  <div class="wrap">
    <div class="section-ey">Which fits you</div>
    <div class="section-h2">End-to-end or embedded writers?</div>
    <div class="section-sub">Both are collaborative and daily. The difference is who directs the work and who is accountable for it.</div>
    <div class="cmp">
      <div class="cmp-h"></div>
      <a class="cmp-h cmp-link" href="/ways-to-engage/managed-documentation">End-to-End Documentation</a>
      <a class="cmp-h cmp-link" href="/ways-to-engage/embedded-writers">Embedded Writers</a>
      <div class="cmp-l">You buy</div><div class="cmp-c" data-l="End-to-end">An outcome: a documentation function that works</div><div class="cmp-c" data-l="Embedded">Capacity: a skilled writer for your team</div>
      <div class="cmp-l">Who directs the work</div><div class="cmp-c" data-l="End-to-end">We plan, prioritise and run it, in step with you</div><div class="cmp-c" data-l="Embedded">You direct the work day to day</div>
      <div class="cmp-l">Accountable for quality</div><div class="cmp-c" data-l="End-to-end">Docifice, for the whole function</div><div class="cmp-c" data-l="Embedded">Shared: you set priorities, we stand behind our writers and their work</div>
      <div class="cmp-l">Team size</div><div class="cmp-c" data-l="End-to-end">A team that scales with the scope of work</div><div class="cmp-c" data-l="Embedded">One writer or several, added as you need them</div>
      <div class="cmp-l">Best for</div><div class="cmp-c" data-l="End-to-end">Teams that want documentation handled</div><div class="cmp-c" data-l="Embedded">Teams with a docs function that need more hands</div>
    </div>
  </div>
</div>

<div class="section">
  <div class="wrap">
    <div class="section-ey">FAQs</div>
    <div class="section-h2">Common questions.</div>
    <div class="faq-list">
      <div class="faq-item">
        <div class="faq-q">How is end-to-end documentation priced? <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
        <div class="faq-a">Engagements are scoped to the work. Depending on what you need, we offer a fixed project fee or a monthly retainer. Get in touch and we will recommend the better fit.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">What do you need from our team? <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
        <div class="faq-a">Access to the product, a point of contact, and time with subject matter experts for reviews. We handle the planning, writing and project management around that.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">Can you work in our tools? <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
        <div class="faq-a">Yes. We work in your repositories, CMS or knowledge base, including Markdown, Git, Confluence, Notion and help-centre platforms.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">Do you keep documentation current after launch? <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
        <div class="faq-a">Yes. Many clients keep us on after the initial build so documentation moves with each release.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">How is this different from embedded writers? <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
        <div class="faq-a">With end-to-end documentation, we plan and run the work and are accountable for the outcome. With embedded writers, a writer joins your team and you direct the work. Both involve working with you every day.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">Can we start small? <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
        <div class="faq-a">Yes. Many engagements begin with one product area or one document set, then grow once the process is working.</div>
      </div>
    </div>
  </div>
</div>

<!-- CTA + WAVES -->
<div class="bottom">
  <div class="wrap">
    <div class="cta">
      <div class="cta-eyebrow">Ready when you are</div>
      <h2 class="cta-h2">Documentation owned by us, <em>shaped with you.</em></h2>
      <p class="cta-sub">Tell us what you need documented. We will come back with a plan and a clear way to get started.</p>
      <div class="cta-btns">
        <a href="/contact" class="cta-dark">Get in touch <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/process" class="cta-light">See how we work <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0a0a0a" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
      </div>
    </div>
  </div>
  <canvas id="waveCanvas"></canvas>
</div>

<script>
document.querySelectorAll('.faq-q').forEach(q => {
  q.addEventListener('click', () => {
    const item = q.parentElement;
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
    if (!isOpen) item.classList.add('open');
  });
});
const wc=document.getElementById('waveCanvas');
const wx=wc&&wc.getContext('2d');
function resize(){if(!wc)return;wc.width=wc.offsetWidth;wc.height=200;}
resize();window.addEventListener('resize',resize);
const layers=[
  {a:20,s:.0009,c1:'#b8d0e8',c2:'#88b0d0',y:0.44,o:.5,p:0},
  {a:18,s:.0007,c1:'#4888c0',c2:'#0078D4',y:0.54,o:.62,p:1.8},
  {a:18,s:.0011,c1:'#0060a8',c2:'#004880',y:0.65,o:.72,p:3.2},
